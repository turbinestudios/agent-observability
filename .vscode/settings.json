{
  "agentObservability.workflows": [
    {
      "repository": "https://github.com/turbinestudios/agent-observability",
      "workflows": [
        {
          "name": "coherence-check",
          "steps": [
            {
              "name": "Use Coherence Check Skill",
              "predicate": {
                "operation": "execute_tool",
                "toolName": "read_file"
              },
              "contentPredicate": {
                "attribute": "gen_ai.tool.call.arguments",
                "contains": "coherence-check-key-files.yml"
              }
            }
          ]
        }
      ]
    }
  ]
}
