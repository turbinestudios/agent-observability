  "$id": "https://turbine.dev/schemas/shared-session.schema.json",
  "title": "Agent Observability Shared Session (v1.x)",
  "description": "One session a user exported to a file to share with a colleague. Carries raw content (prompts and responses, secrets redacted best-effort). Generated from src/core/agent-observability-core/src/share/sharedSessionShape.ts; do not edit by hand.",
