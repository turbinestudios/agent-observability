@page "/repository/{EncodedRepoUrl}"
@using System.Globalization
@using Microsoft.Extensions.Options
@inject LogAnalyticsService Analytics
@inject NavigationManager Navigation
@inject IOptions<WebUxOptions> WebUx

<PageTitle>Repository – @DecodedRepoUrl</PageTitle>

@if (ExposeRawSessionDetail)
{
    <section class="page-header">
        <div>
            <p class="eyebrow"><a href="/repository">Repository</a> / Detail</p>
            <h1>@DecodedRepoUrl</h1>
            <p class="page-copy">Agent sessions in this repository over the last 24 hours. Click a session to inspect its workflow.</p>
        </div>
    </section>

    @if (sessions.Count == 0)
    {
        <p class="loading-state">Loading sessions...</p>
    }
    else
    {
        <section class="panel-card">
            <div class="panel-heading">
                <h2>Agent Sessions</h2>
                <span>@sessions.Count sessions found</span>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Session</th>
                        <th>User</th>
                        <th>Started</th>
                        <th>Duration</th>
                        <th>Requests</th>
                        <th>Agent Modes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in sessions)
                    {
                        <tr>
                            <td><a href="/repository/@EncodedRepoUrl/session/@Uri.EscapeDataString(session.SessionId)">@session.SessionId[..8]…</a></td>
                            <td>@session.User</td>
                            <td>@session.StartTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@FormatDuration(session.EndTime - session.StartTime)</td>
                            <td>@session.RequestCount.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td>@session.AgentModes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
else
{
    <section class="page-header">
        <div>
            <p class="eyebrow"><a href="/repository">Repository</a> / Detail</p>
            <h1>@DecodedRepoUrl</h1>
            <p class="page-copy">This is the organization-level, privacy-preserving view. Aggregate adoption and health for this repository remain on the <a href="/repository">Repository</a> page.</p>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-heading">
            <h2>Individual session detail moved to your editor</h2>
        </div>
        <div class="empty-state" style="padding: 1.5rem; line-height: 1.6;">
            <p>
                Individual agent sessions and their prompt/response detail are no longer shown in the
                organization dashboard. They now live locally in the
                <strong>Agent Observability (Local)</strong> VS Code extension, so raw prompt and
                response content stays on each developer's machine.
            </p>
            <p>
                Open the extension in VS Code to inspect a specific session's workflow timeline.
                The organization dashboard continues to show aggregate, team-level activity.
            </p>
            <p style="margin-top: 1rem;">
                <a class="action-button action-button-secondary" href="/repository">← Back to repository overview</a>
            </p>
        </div>
    </section>
}

@code {
    [Parameter]
    public string EncodedRepoUrl { get; set; } = string.Empty;

    private bool ExposeRawSessionDetail => WebUx.Value.ExposeRawSessionDetail;

    private string DecodedRepoUrl => DecodeRepoUrl(EncodedRepoUrl);

    private IReadOnlyList<AgentSessionSummary> sessions = [];

    protected override async Task OnInitializedAsync()
    {
        // Privacy-first default: do not query raw Log Analytics tables when raw detail is hidden.
        if (!ExposeRawSessionDetail)
        {
            return;
        }

        sessions = await Analytics.GetSessionsByRepositoryAsync(DecodedRepoUrl, TimeSpan.FromHours(24));
    }

    private static string DecodeRepoUrl(string encoded)
    {
        try
        {
            var padded = encoded.Replace('-', '+').Replace('_', '/');
            switch (padded.Length % 4)
            {
                case 2: padded += "=="; break;
                case 3: padded += "="; break;
            }
            return System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(padded));
        }
        catch
        {
            return encoded;
        }
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMinutes < 1) return $"{duration.Seconds}s";
        if (duration.TotalHours < 1) return $"{(int)duration.TotalMinutes}m {duration.Seconds}s";
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }
}
