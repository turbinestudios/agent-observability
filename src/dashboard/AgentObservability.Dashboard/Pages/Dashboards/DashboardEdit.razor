@page "/dashboards/{Id}/edit"
@layout AgentObservability.Dashboard.Components.Layout.DashboardLayout
@inject AgentObservability.Dashboard.Services.DashboardService DashboardService
@inject AgentObservability.Dashboard.Services.WidgetQueryService WidgetQueryService
@inject NavigationManager Navigation
@inject Radzen.NotificationService NotificationService
@inject IJSRuntime JS
@using AgentObservability.Dashboard.Models
@implements IAsyncDisposable

<PageTitle>Edit - @(dashboard?.Name ?? "Dashboard")</PageTitle>

@if (dashboard is null)
{
    <p class="loading-state">Loading dashboard...</p>
}
else
{
    <div class="dashboard-toolbar">
        <div>
            <p class="eyebrow">Editing Dashboard</p>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <input class="form-group input" style="font-size: 1.5rem; font-weight: 700; border: none; background: transparent; padding: 0; width: auto;"
                       @bind="dashboard.Name" @bind:event="oninput" />
            </div>
        </div>
        <div class="dashboard-toolbar-actions">
            <select class="time-range-select" @onchange="OnTimeRangeChanged" value="@selectedTimeRange">
                <option value="1">Last 1 hour</option>
                <option value="4">Last 4 hours</option>
                <option value="12">Last 12 hours</option>
                <option value="24">Last 24 hours</option>
                <option value="72">Last 3 days</option>
                <option value="168">Last 7 days</option>
                <option value="720">Last 30 days</option>
            </select>
            <button class="action-button action-button-secondary" @onclick="Cancel">Cancel</button>
            <button class="action-button" @onclick="Save">Save</button>
        </div>
    </div>

    <!-- Dashboard Settings -->
    <div class="widget-config-panel" style="margin-bottom: 1.5rem;">
        <h3>Dashboard Settings</h3>
        <div class="widget-config-grid">
            <div class="form-group full-width">
                <label>Description</label>
                <input @bind="dashboard.Description" @bind:event="oninput" placeholder="Dashboard description..." />
            </div>
        </div>
    </div>

    <!-- Filters Configuration -->
    <div class="widget-config-panel" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="margin: 0;">Filters</h3>
            <button class="btn-icon" @onclick="AddFilter" title="Add filter">+</button>
        </div>

        @for (int i = 0; i < dashboard.Filters.Count; i++)
        {
            var idx = i;
            var filter = dashboard.Filters[idx];
            <div class="form-row" style="margin-bottom: 0.5rem; align-items: end;">
                <div class="form-group">
                    <label>Type</label>
                    <select @bind="filter.FilterType">
                        @foreach (var ft in Enum.GetValues<DashboardFilterType>())
                        {
                            <option value="@ft">@ft</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Values (comma-separated)</label>
                    <input value="@string.Join(", ", filter.Values)"
                           @onchange="e => UpdateFilterValues(idx, e.Value?.ToString())" />
                </div>
                <button class="btn-icon" @onclick="() => RemoveFilter(idx)" title="Remove filter">✕</button>
            </div>
        }

        @if (dashboard.Filters.Count == 0)
        {
            <p class="empty-state" style="padding: 0.5rem;">No filters configured.</p>
        }
    </div>

    <!-- Widget Grid Editor -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="margin: 0;">Widgets</h2>
        <button class="action-button" @onclick="AddWidget">+ Add Widget</button>
    </div>

    @if (widgets.Count == 0)
    {
        <div class="widget-placeholder" @onclick="AddWidget">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <span>Click to add your first widget</span>
        </div>
    }
    else
    {
        <div class="widget-grid" style="grid-template-rows: repeat(@maxRow, minmax(180px, auto)); margin-bottom: 1.5rem;">
            @foreach (var widget in widgets)
            {
                <div class="widget-cell editing"
                     style="grid-column: @widget.GridColumn / span @widget.ColumnSpan; grid-row: @widget.GridRow / span @widget.RowSpan;"
                     @onclick="() => EditWidget(widget)">
                    <div class="widget-cell-header">
                        <h4>@widget.Title</h4>
                        <div style="display: flex; gap: 0.25rem;">
                            <button class="btn-icon" @onclick="() => EditWidget(widget)" @onclick:stopPropagation title="Edit">✎</button>
                            <button class="btn-icon" @onclick="() => RemoveWidget(widget)" @onclick:stopPropagation title="Remove">✕</button>
                        </div>
                    </div>
                    <div class="widget-cell-body">
                        @if (IsWidgetLoading(widget.Id))
                        {
                            <span class="spinner"></span>
                        }
                        else if (editingWidget?.Id == widget.Id && editingWidgetResult is not null)
                        {
                            <AgentObservability.Dashboard.Components.Widgets.WidgetRenderer
                                Widget="editingWidget"
                                QueryResult="editingWidgetResult" />
                        }
                        else if (!string.IsNullOrWhiteSpace(widget.KqlQuery))
                        {
                            <AgentObservability.Dashboard.Components.Widgets.WidgetRenderer
                                Widget="widget"
                                QueryResult="GetWidgetResult(widget.Id)" />
                        }
                        else
                        {
                            <span style="color: var(--muted); font-size: 0.85rem;">@widget.WidgetType — @widget.ColumnSpan×@widget.RowSpan</span>
                        }
                        @{ var missing = GetMissingFilters(widget); }
                        @if (missing.Count > 0)
                        {
                            <span class="widget-filter-warning-badge" title="Missing filters: @string.Join(", ", missing)">⚠</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Widget Editor Panel -->
    @if (editingWidget is not null)
    {
        <div class="widget-config-panel">
            <h3>@(isNewWidget ? "Add Widget" : "Edit Widget")</h3>
            <div class="widget-config-grid">
                <div class="form-group">
                    <label>Title</label>
                    <input @bind="editingWidget.Title" @bind:event="oninput" placeholder="Widget title" />
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <select @bind="editingWidget.WidgetType">
                        @foreach (var wt in Enum.GetValues<WidgetType>())
                        {
                            <option value="@wt">@wt</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Column (1-12)</label>
                    <input type="number" min="1" max="12" @bind="editingWidget.GridColumn" />
                </div>
                <div class="form-group">
                    <label>Row</label>
                    <input type="number" min="1" @bind="editingWidget.GridRow" />
                </div>
                <div class="form-group">
                    <label>Column Span (1-12)</label>
                    <input type="number" min="1" max="12" @bind="editingWidget.ColumnSpan" />
                </div>
                <div class="form-group">
                    <label>Row Span</label>
                    <input type="number" min="1" max="4" @bind="editingWidget.RowSpan" />
                </div>
                <div class="form-group full-width">
                    <label>KQL Query <span class="hint">(Ctrl+Space to insert filter)</span></label>
                    <div class="query-editor-container">
                        <textarea @ref="queryTextareaRef" rows="6"
                                  class="query-textarea"
                                  @bind="editingWidget.KqlQuery" @bind:event="oninput"
                                  placeholder="Enter your KQL query..."></textarea>

                        @if (showFilterPopup)
                        {
                            <div class="filter-popup" style="top: @(popupTop)px; left: @(popupLeft)px;">
                                <div class="filter-popup-header">Insert filter where-clause</div>
                                @foreach (var snippet in GetAvailableFilterSnippets())
                                {
                                    <button class="filter-popup-item" @onclick="() => InsertFilterSnippet(snippet.Kql)">
                                        <span class="filter-popup-item-label">@snippet.Label</span>
                                        <span class="filter-popup-item-kql">@snippet.Kql</span>
                                    </button>
                                }
                                @if (!GetAvailableFilterSnippets().Any())
                                {
                                    <div class="filter-popup-empty">No dashboard filters configured</div>
                                }
                            </div>
                        }
                    </div>
                    @{ var editMissing = GetMissingFilters(editingWidget); }
                    @if (editMissing.Count > 0)
                    {
                        <div class="widget-filter-warning" style="margin-top: 0.5rem;">
                            <span class="warning-icon">⚠</span>
                            <span>This query does not apply: @string.Join(", ", editMissing)</span>
                        </div>
                    }
                    <div class="query-preview-actions" style="margin-top: 0.5rem;">
                        <button class="action-button action-button-secondary" @onclick="RunPreview" disabled="@(previewExecuting || string.IsNullOrWhiteSpace(editingWidget.KqlQuery))">
                            @if (previewExecuting)
                            {
                                <span class="spinner"></span>
                                <span>Running...</span>
                            }
                            else
                            {
                                <span>▶ Run Preview</span>
                            }
                        </button>
                        <button class="action-button" @onclick="SaveWidget">@(isNewWidget ? "Add" : "Update")</button>
                        <button class="action-button action-button-secondary" @onclick="CancelWidgetEdit">Cancel</button>
                    </div>
                </div>

                <!-- AI Query Assistant -->
                <div class="form-group full-width">
                    <button class="ai-assistant-trigger" @onclick="OpenAiAssistant">
                        <span class="trigger-icon">🤖</span>
                        <span>AI Assistant</span>
                    </button>
                </div>
            </div>
        </div>
    }
}

<AiAssistantPanel IsOpen="showAiPanel"
                  OnClose="CloseAiPanel"
                  OnApplyKql="ApplyAiKql"
                  Placeholder="Describe the metric you want or ask a question about the query..."
                  ExistingQuery="@editingWidget?.KqlQuery"
                  Filters="@(dashboard?.Filters ?? [])"
                  WidgetType="@(editingWidget?.WidgetType ?? WidgetType.Table)"
                  ContextKey="@(editingWidget?.Id ?? "")"
                  ContextDescription="@(editingWidget is not null ? $"Widget: {editingWidget.Title}" : null)" />

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private CustomDashboard? dashboard;
    private List<DashboardWidget> widgets = [];
    private DashboardWidget? editingWidget;
    private bool isNewWidget;
    private int maxRow => widgets.Count > 0 ? widgets.Max(w => w.GridRow + w.RowSpan - 1) : 1;

    // Widget preview state
    private Dictionary<string, WidgetQueryResult> widgetResults = new();
    private WidgetQueryResult? editingWidgetResult;
    private string selectedTimeRange = "24";
    private HashSet<string> loadingWidgets = new();
    private bool previewExecuting;

    // Filter popup state
    private ElementReference queryTextareaRef;
    private bool showFilterPopup;
    private double popupTop;
    private double popupLeft;
    private DotNetObjectReference<DashboardEdit>? dotNetRef;

    // AI assistant overlay state
    private bool showAiPanel;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardService.GetDashboardAsync(Id);
        if (dashboard is null)
        {
            Navigation.NavigateTo("/dashboards");
            return;
        }

        widgets = await DashboardService.GetWidgetsAsync(Id);
        await ExecuteAllWidgetQueries();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (editingWidget is not null && queryTextareaRef.Context is not null)
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("queryEditor.registerKeyHandler", queryTextareaRef, dotNetRef);
        }
    }

    [JSInvokable]
    public void OnFilterPopupRequested(double top, double left, int cursorPos)
    {
        popupTop = top + 20; // offset below cursor
        popupLeft = left;
        showFilterPopup = true;
        StateHasChanged();
    }

    private async Task InsertFilterSnippet(string kql)
    {
        showFilterPopup = false;
        var newValue = await JS.InvokeAsync<string>("queryEditor.insertAtCursor", queryTextareaRef, kql);
        if (editingWidget is not null)
        {
            editingWidget.KqlQuery = newValue;
        }
        StateHasChanged();
    }

    private List<FilterSnippet> GetAvailableFilterSnippets()
    {
        if (dashboard is null) return [];

        var snippets = new List<FilterSnippet>();
        foreach (var filter in dashboard.Filters)
        {
            switch (filter.FilterType)
            {
                case DashboardFilterType.Repository:
                    snippets.Add(new FilterSnippet(
                        "Repository",
                        "| where tostring(Properties[\"copilot_chat.repo.remote_url\"]) in (_filter_repositories)"));
                    break;
                case DashboardFilterType.Developer:
                    snippets.Add(new FilterSnippet(
                        "Developer",
                        "| where tostring(Properties[\"user.email\"]) in (_filter_developers)"));
                    break;
                case DashboardFilterType.Custom when !string.IsNullOrEmpty(filter.Key):
                    var sanitizedKey = filter.Key.ToLowerInvariant().Replace(" ", "_");
                    snippets.Add(new FilterSnippet(
                        $"Custom: {filter.Key}",
                        $"| where tostring(Properties[\"{filter.Key}\"]) in (_filter_{sanitizedKey})"));
                    break;
            }
        }
        return snippets;
    }

    private List<string> GetMissingFilters(DashboardWidget widget)
    {
        if (dashboard is null || string.IsNullOrWhiteSpace(widget.KqlQuery)) return [];

        var missing = new List<string>();
        foreach (var filter in dashboard.Filters)
        {
            switch (filter.FilterType)
            {
                case DashboardFilterType.Repository when filter.Values.Count > 0:
                    if (!widget.KqlQuery.Contains("_filter_repositories"))
                        missing.Add("Repository");
                    break;
                case DashboardFilterType.Developer when filter.Values.Count > 0:
                    if (!widget.KqlQuery.Contains("_filter_developers"))
                        missing.Add("Developer");
                    break;
                case DashboardFilterType.Custom when !string.IsNullOrEmpty(filter.Key) && filter.Values.Count > 0:
                    var sanitizedKey = filter.Key.ToLowerInvariant().Replace(" ", "_");
                    if (!widget.KqlQuery.Contains($"_filter_{sanitizedKey}"))
                        missing.Add($"Custom: {filter.Key}");
                    break;
            }
        }
        return missing;
    }

    private void AddFilter()
    {
        dashboard!.Filters.Add(new DashboardFilter());
    }

    private void RemoveFilter(int index)
    {
        dashboard!.Filters.RemoveAt(index);
    }

    private void UpdateFilterValues(int index, string? raw)
    {
        if (raw is null) return;
        dashboard!.Filters[index].Values = raw
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private void AddWidget()
    {
        var nextRow = widgets.Count > 0 ? widgets.Max(w => w.GridRow + w.RowSpan) : 1;
        editingWidget = new DashboardWidget
        {
            DashboardId = Id,
            Title = "New Widget",
            GridColumn = 1,
            GridRow = nextRow,
            ColumnSpan = 4,
            RowSpan = 1
        };
        isNewWidget = true;
        showAiPanel = false;
    }

    private void EditWidget(DashboardWidget widget)
    {
        editingWidget = new DashboardWidget
        {
            Id = widget.Id,
            DashboardId = widget.DashboardId,
            Title = widget.Title,
            WidgetType = widget.WidgetType,
            KqlQuery = widget.KqlQuery,
            GridColumn = widget.GridColumn,
            GridRow = widget.GridRow,
            ColumnSpan = widget.ColumnSpan,
            RowSpan = widget.RowSpan,
            Configuration = widget.Configuration
        };
        isNewWidget = false;
        editingWidgetResult = widgetResults.GetValueOrDefault(widget.Id);
        showAiPanel = false;
    }

    private async Task SaveWidget()
    {
        if (editingWidget is null) return;

        if (isNewWidget)
        {
            await DashboardService.AddWidgetAsync(editingWidget);
        }
        else
        {
            await DashboardService.UpdateWidgetAsync(editingWidget);
        }

        if (editingWidgetResult is not null)
        {
            widgetResults[editingWidget.Id] = editingWidgetResult;
        }

        widgets = await DashboardService.GetWidgetsAsync(Id);
        editingWidget = null;
        editingWidgetResult = null;
    }

    private void CancelWidgetEdit()
    {
        editingWidget = null;
        editingWidgetResult = null;
        showAiPanel = false;
    }

    private async Task RemoveWidget(DashboardWidget widget)
    {
        await DashboardService.RemoveWidgetAsync(widget.DashboardId, widget.Id);
        widgets = await DashboardService.GetWidgetsAsync(Id);
    }

    private async Task Save()
    {
        if (dashboard is null) return;
        await DashboardService.UpdateDashboardAsync(dashboard);
        NotificationService.Notify(new Radzen.NotificationMessage
        {
            Summary = "Dashboard saved",
            Severity = Radzen.NotificationSeverity.Success,
            Duration = 3000
        });
        Navigation.NavigateTo($"/dashboards/{Id}");
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/dashboards/{Id}");
    }

    // ─── AI Assistant Overlay ────────────────────────────────────────────────────

    private void OpenAiAssistant()
    {
        showAiPanel = true;
    }

    private void CloseAiPanel()
    {
        showAiPanel = false;
    }

    private async Task ApplyAiKql(string kql)
    {
        if (editingWidget is null || string.IsNullOrEmpty(kql)) return;
        editingWidget.KqlQuery = kql;
        await ExecuteEditingWidgetQuery();
    }

    private async Task RunPreview()
    {
        await ExecuteEditingWidgetQuery();
    }

    private async Task ExecuteEditingWidgetQuery()
    {
        if (editingWidget is null || string.IsNullOrWhiteSpace(editingWidget.KqlQuery)) return;

        previewExecuting = true;
        StateHasChanged();

        try
        {
            var lookback = TimeSpan.FromHours(double.Parse(selectedTimeRange));
            editingWidgetResult = await WidgetQueryService.ExecuteWidgetQueryAsync(
                editingWidget.KqlQuery,
                dashboard?.Filters ?? [],
                lookback);
        }
        finally
        {
            previewExecuting = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteAllWidgetQueries()
    {
        var lookback = TimeSpan.FromHours(double.Parse(selectedTimeRange));

        var widgetsWithQueries = widgets.Where(w => !string.IsNullOrWhiteSpace(w.KqlQuery)).ToList();
        foreach (var w in widgetsWithQueries)
        {
            loadingWidgets.Add(w.Id);
        }
        StateHasChanged();

        try
        {
            var tasks = widgetsWithQueries.Select(async widget =>
            {
                var result = await WidgetQueryService.ExecuteWidgetQueryAsync(
                    widget.KqlQuery,
                    dashboard?.Filters ?? [],
                    lookback);
                return (widget.Id, result);
            });

            var results = await Task.WhenAll(tasks);
            widgetResults = results.ToDictionary(r => r.Id, r => r.result);
        }
        finally
        {
            loadingWidgets.Clear();
            StateHasChanged();
        }
    }

    private WidgetQueryResult? GetWidgetResult(string widgetId)
    {
        return widgetResults.GetValueOrDefault(widgetId);
    }

    private bool IsWidgetLoading(string widgetId)
    {
        return loadingWidgets.Contains(widgetId);
    }

    private async Task OnTimeRangeChanged(ChangeEventArgs e)
    {
        selectedTimeRange = e.Value?.ToString() ?? "24";
        await ExecuteAllWidgetQueries();
        if (editingWidget is not null && !string.IsNullOrWhiteSpace(editingWidget.KqlQuery))
        {
            await ExecuteEditingWidgetQuery();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (queryTextareaRef.Context is not null)
        {
            await JS.InvokeVoidAsync("queryEditor.unregisterKeyHandler", queryTextareaRef);
        }
        dotNetRef?.Dispose();
    }

    private sealed record FilterSnippet(string Label, string Kql);
}
