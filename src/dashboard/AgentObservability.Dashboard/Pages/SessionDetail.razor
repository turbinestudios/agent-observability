@page "/repository/{EncodedRepoUrl}/session/{SessionId}"
@using System.Globalization
@using Microsoft.Extensions.Options
@inject LogAnalyticsService Analytics
@inject WorkflowDeviationDetector DeviationDetector
@inject IOptions<WebUxOptions> WebUx

<PageTitle>Session – @TruncatedSessionId</PageTitle>

@if (ExposeRawSessionDetail)
{
    <section class="page-header">
        <div>
            <p class="eyebrow"><a href="/repository">Repository</a> / <a href="/repository/@EncodedRepoUrl">@DecodedRepoUrl</a> / Session</p>
            <h1>Session @TruncatedSessionId</h1>
            <p class="page-copy">Chronological view of all interactions in this agent session, with workflow deviation detection.</p>
        </div>
    </section>

    @if (interactions.Count == 0 && !loaded)
    {
        <p class="loading-state">Loading session interactions...</p>
    }
    else if (interactions.Count == 0 && loaded)
    {
        <p class="loading-state">No interactions found for this session.</p>
    }
    else
    {
        @if (deviations.Count > 0)
        {
            <section class="panel-card">
                <div class="panel-heading">
                    <h2>Workflow Deviations</h2>
                    <span>@deviations.Count issue(s) detected</span>
                </div>

                <div class="deviation-list">
                    @foreach (var deviation in deviations)
                    {
                        <article class="deviation-card deviation-card-@deviation.Type.ToString().ToLowerInvariant()">
                            <div class="deviation-header">
                                <span class="deviation-type-badge">@deviation.Type</span>
                                <span class="deviation-workflow">@deviation.WorkflowName</span>
                            </div>
                            <p>@deviation.Description</p>
                            @if (deviation.ActualSequence.Count > 0)
                            {
                                <div class="deviation-sequence">
                                    <strong>Actual:</strong> @string.Join(" → ", deviation.ActualSequence)
                                </div>
                            }
                            @if (deviation.ExpectedSequence.Count > 0)
                            {
                                <div class="deviation-sequence">
                                    <strong>Expected:</strong> @string.Join(" → ", deviation.ExpectedSequence)
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="panel-card">
                <div class="panel-heading">
                    <h2>Workflow Deviations</h2>
                    <span>No deviations detected</span>
                </div>
                <p style="padding: 1rem; color: var(--text-secondary);">This session's workflow matches expected patterns.</p>
            </section>
        }

        <section class="panel-card">
            <div class="panel-heading">
                <h2>Interactions</h2>
                <span>@interactions.Count interactions</span>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Agent Mode</th>
                        <th>Tool</th>
                        <th>User Request</th>
                        <th>Model</th>
                        <th>Duration</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in interactions)
                    {
                        <tr>
                            <td>@item.Timestamp.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</td>
                            <td>@item.AgentMode</td>
                            <td>@item.ToolName</td>
                            <td class="user-request-cell" title="@item.UserRequest">@Truncate(item.UserRequest, 60)</td>
                            <td>@item.Model</td>
                            <td>@item.DurationMs.ToString("N0", CultureInfo.InvariantCulture) ms</td>
                            <td><span class="status-pill @(item.Success ? "status-success" : "status-failure")">@(item.Success ? "OK" : "Fail")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
else
{
    <section class="page-header">
        <div>
            <p class="eyebrow"><a href="/repository">Repository</a> / Session</p>
            <h1>Session detail moved to your editor</h1>
            <p class="page-copy">This is the organization-level, privacy-preserving view. Per-session interaction detail is no longer available here.</p>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-heading">
            <h2>Individual session detail moved to your editor</h2>
        </div>
        <div class="empty-state" style="padding: 1.5rem; line-height: 1.6;">
            <p>
                The prompt/response timeline and workflow deviation detail for individual agent
                sessions are no longer shown in the organization dashboard. They now live locally in
                the <strong>Agent Observability (Local)</strong> VS Code extension, so raw prompt and
                response content stays on each developer's machine.
            </p>
            <p>
                Open the extension in VS Code to inspect this session's interactions. The
                organization dashboard continues to show aggregate, team-level activity.
            </p>
            <p style="margin-top: 1rem;">
                <a class="action-button action-button-secondary" href="/repository">← Back to repository overview</a>
            </p>
        </div>
    </section>
}

@code {
    [Parameter]
    public string EncodedRepoUrl { get; set; } = string.Empty;

    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    private bool ExposeRawSessionDetail => WebUx.Value.ExposeRawSessionDetail;

    private string DecodedRepoUrl => DecodeRepoUrl(EncodedRepoUrl);
    private string DecodedSessionId => Uri.UnescapeDataString(SessionId);
    private string TruncatedSessionId => DecodedSessionId.Length > 8 ? DecodedSessionId[..8] + "…" : DecodedSessionId;

    private IReadOnlyList<SessionInteraction> interactions = [];
    private IReadOnlyList<WorkflowDeviation> deviations = [];
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        // Privacy-first default: do not query raw Log Analytics tables or run deviation
        // detection when raw session detail is hidden.
        if (!ExposeRawSessionDetail)
        {
            return;
        }

        var interactionsTask = Analytics.GetSessionInteractionsAsync(DecodedSessionId, TimeSpan.FromHours(24));
        var deviationInteractionsTask = Analytics.GetSessionInteractionsForDeviationAsync(DecodedSessionId, DecodedRepoUrl, TimeSpan.FromHours(24));

        interactions = await interactionsTask;
        var agentInteractions = await deviationInteractionsTask;

        var configs = WorkflowConfig.Examples
            .Where(c => DecodedRepoUrl.Contains(c.Repository, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (configs.Count > 0 && agentInteractions.Count > 0)
        {
            deviations = DeviationDetector.DetectDeviations(agentInteractions, configs);
        }

        loaded = true;
    }

    private static string DecodeRepoUrl(string encoded)
    {
        try
        {
            var padded = encoded.Replace('-', '+').Replace('_', '/');
            switch (padded.Length % 4)
            {
                case 2: padded += "=="; break;
                case 3: padded += "="; break;
            }
            return System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(padded));
        }
        catch
        {
            return encoded;
        }
    }

    private static string Truncate(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return "";
        return value.Length <= maxLength ? value : value[..maxLength] + "…";
    }
}
