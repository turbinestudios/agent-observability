@page "/repository"
@using System.Globalization
@inject LogAnalyticsService Analytics

<PageTitle>Repository</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Repository</p>
        <h1>Adoption and health by repository</h1>
        <p class="page-copy">Compare usage depth, developer coverage, and latency between repositories to find the teams that need support or have strong adoption.</p>
    </div>
</section>

@if (repositories.Count == 0)
{
    <p class="loading-state">Loading repository analytics...</p>
}
else
{
    <section class="chart-grid chart-grid-wide">
        <article class="panel-card">
            <div class="panel-heading">
                <h2>Request Volume by Repository</h2>
                <span>Last 24 hours</span>
            </div>

            <RadzenChart>
                <RadzenBarSeries Data="@repositories" CategoryProperty="Repository" ValueProperty="Requests" Title="Requests" />
                <RadzenCategoryAxis />
                <RadzenValueAxis />
            </RadzenChart>
        </article>

        <article class="panel-card">
            <div class="panel-heading">
                <h2>Active Developers by Repository</h2>
                <span>Coverage snapshot</span>
            </div>

            <RadzenChart>
                <RadzenColumnSeries Data="@repositories" CategoryProperty="Repository" ValueProperty="ActiveDevelopers" Title="Developers" />
                <RadzenCategoryAxis />
                <RadzenValueAxis />
            </RadzenChart>
        </article>
    </section>

    <section class="panel-card">
        <div class="panel-heading">
            <h2>Repository Summary</h2>
            <span>Ranked by request volume</span>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Repository</th>
                    <th>Requests</th>
                    <th>Developers</th>
                    <th>Avg Latency</th>
                    <th>Models</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in repositories)
                {
                    <tr>
                        <td><a href="/repository/@EncodeRepoUrl(item.Repository)">@item.Repository</a></td>
                        <td>@item.Requests.ToString("N0", CultureInfo.InvariantCulture)</td>
                        <td>@item.ActiveDevelopers</td>
                        <td>@item.AverageLatencyMs.ToString("N0", CultureInfo.InvariantCulture) ms</td>
                        <td>@item.UniqueModels</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyList<RepositoryActivitySummary> repositories = [];

    protected override async Task OnInitializedAsync()
    {
        repositories = await Analytics.GetRepositoryActivityAsync(TimeSpan.FromHours(24));
    }

    private static string EncodeRepoUrl(string url)
    {
        return Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(url))
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');
    }
}