@page "/workflows/{Id}/edit"
@layout AgentObservability.Dashboard.Components.Layout.WorkflowLayout
@inject AgentObservability.Dashboard.Services.WorkflowManagementService WorkflowService
@inject AgentObservability.Dashboard.Services.WidgetQueryService QueryService
@inject NavigationManager Navigation
@inject Radzen.NotificationService NotificationService
@using AgentObservability.Dashboard.Models

<PageTitle>Edit - @(workflow?.Name ?? "Workflow")</PageTitle>

@if (workflow is null)
{
    <p class="loading-state">Loading workflow...</p>
}
else
{
    <div class="dashboard-toolbar">
        <div>
            <p class="eyebrow">Editing Workflow</p>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <input class="form-group input" style="font-size: 1.5rem; font-weight: 700; border: none; background: transparent; padding: 0; width: auto;"
                       @bind="workflow.Name" @bind:event="oninput" />
            </div>
        </div>
        <div class="dashboard-toolbar-actions">
            <button class="action-button action-button-secondary" @onclick="Cancel">Cancel</button>
            <button class="action-button" @onclick="Save">Save</button>
        </div>
    </div>

    <!-- Trigger KQL Query -->
    <div class="widget-config-panel" style="margin-bottom: 1.5rem;">
        <h3>Trigger KQL Query</h3>
        <p style="color: var(--muted); font-size: 0.85rem; margin-bottom: 0.75rem;">
            Define a KQL query that identifies workflow instances. The query should return an <code>OperationId</code> column to correlate with step logs.
        </p>
        <div class="form-group full-width">
            <textarea rows="8" class="query-textarea"
                      @bind="workflow.TriggerKqlQuery" @bind:event="oninput"
                      placeholder="Enter your trigger KQL query..."></textarea>
            <div class="query-preview-actions" style="margin-top: 0.5rem;">
                <button class="action-button action-button-secondary" @onclick="RunPreview" disabled="@(previewExecuting || string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery))">
                    @if (previewExecuting)
                    {
                        <span class="spinner"></span>
                        <span>Running...</span>
                    }
                    else
                    {
                        <span>▶ Run Preview</span>
                    }
                </button>
            </div>
        </div>

        @if (previewResult?.Error is not null)
        {
            <div class="widget-error" style="margin-top: 0.75rem;">
                <strong>Query Error:</strong> @previewResult.Error
            </div>
        }
        else if (previewResult is not null)
        {
            <div style="margin-top: 0.75rem;">
                <span class="tree-badge">@previewResult.Rows.Count result(s)</span>
                @if (previewResult.Rows.Count > 0)
                {
                    <div class="widget-table-container" style="max-height: 200px; overflow-y: auto; margin-top: 0.5rem;">
                        <table class="widget-table">
                            <thead>
                                <tr>
                                    @foreach (var col in previewResult.Columns)
                                    {
                                        <th>@col</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in previewResult.Rows.Take(10))
                                {
                                    <tr>
                                        @foreach (var col in previewResult.Columns)
                                        {
                                            <td>@(row.TryGetValue(col, out var val) ? val?.ToString() ?? "" : "")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (previewResult.Rows.Count > 10)
                    {
                        <p style="color: var(--muted); font-size: 0.8rem; margin-top: 0.25rem;">Showing first 10 of @previewResult.Rows.Count results</p>
                    }
                }
            </div>
        }

        <!-- AI Query Assistant -->
        <div class="form-group full-width" style="margin-top: 1rem;">
            <button class="ai-assistant-trigger" @onclick="OpenTriggerAiAssistant">
                <span class="trigger-icon">🤖</span>
                <span>AI Assistant</span>
            </button>
        </div>
    </div>

    <!-- Expected Steps -->
    <div class="widget-config-panel" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
                <h3 style="margin: 0;">Expected Steps</h3>
                <p style="color: var(--muted); font-size: 0.85rem; margin: 0.25rem 0 0;">
                    Define the expected step sequence. Each step uses a KQL query to detect its occurrence. Use <code>_filter_operationid</code> to reference the OperationId from the trigger result.
                </p>
            </div>
            <button class="action-button" @onclick="AddStep">+ Add Step</button>
        </div>

        @if (workflow.Steps.Count == 0)
        {
            <div class="empty-state" style="padding: 1rem;">
                <p>No steps configured. Add steps to define the expected workflow sequence.</p>
            </div>
        }
        else
        {
            @for (int i = 0; i < workflow.Steps.Count; i++)
            {
                var idx = i;
                var step = workflow.Steps[idx];
                <div class="workflow-step-editor" style="flex-direction: column; align-items: stretch;">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <span class="step-number-badge">@step.Order</span>

                        <div class="form-group" style="flex: 1;">
                            <label>Step Name</label>
                            <input @bind="step.Name" @bind:event="oninput" placeholder="e.g. File Read, Code Generation" />
                        </div>

                        <div class="step-actions">
                            <button class="btn-icon" @onclick="() => MoveStepUp(idx)" disabled="@(idx == 0)" title="Move up">↑</button>
                            <button class="btn-icon" @onclick="() => MoveStepDown(idx)" disabled="@(idx == workflow.Steps.Count - 1)" title="Move down">↓</button>
                            <button class="btn-icon" @onclick="() => RemoveStep(idx)" title="Remove">✕</button>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top: 0.5rem;">
                        <label>KQL Query</label>
                        <textarea rows="4" class="query-textarea"
                                  @bind="step.KqlQuery" @bind:event="oninput"
                                  placeholder="e.g. AppDependencies | where OperationId == _filter_operationid | where Name == &quot;read_file&quot;"></textarea>
                    </div>

                    <!-- Step AI Query Assistant -->
                    <div style="margin-top: 0.5rem;">
                        <button class="ai-assistant-trigger" @onclick="() => OpenStepAiAssistant(idx)">
                            <span class="trigger-icon">🤖</span>
                            <span>AI Assistant</span>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
}

<AiAssistantPanel IsOpen="showAiPanel"
                  OnClose="CloseAiPanel"
                  OnApplyKql="ApplyAiKql"
                  Placeholder="@aiPanelPlaceholder"
                  ExistingQuery="@aiPanelExistingQuery"
                  Filters="[]"
                  WidgetType="WidgetType.Table"
                  ExtraPromptContext="@aiPanelExtraContext"
                  ContextKey="@aiPanelContextKey" />

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ManagedWorkflow? workflow;

    // Preview state
    private WidgetQueryResult? previewResult;
    private bool previewExecuting;

    // AI assistant overlay state
    private bool showAiPanel;
    private string aiPanelPlaceholder = "Describe the workflow trigger you want to match...";
    private string? aiPanelExistingQuery;
    private string? aiPanelExtraContext;
    private string aiPanelContextKey = string.Empty;
    private int? aiPanelStepIndex;

    protected override async Task OnInitializedAsync()
    {
        workflow = await WorkflowService.GetWorkflowAsync(Id);
        if (workflow is null)
        {
            Navigation.NavigateTo("/workflows");
        }
    }

    // ─── Steps ──────────────────────────────────────────────────────────────────

    private void AddStep()
    {
        if (workflow is null) return;
        workflow.Steps.Add(new WorkflowStep
        {
            Order = workflow.Steps.Count + 1,
            Name = string.Empty,
            KqlQuery = string.Empty
        });
    }

    private void RemoveStep(int index)
    {
        if (workflow is null) return;
        workflow.Steps.RemoveAt(index);
        ReorderSteps();
    }

    private void MoveStepUp(int index)
    {
        if (workflow is null || index <= 0) return;
        (workflow.Steps[index], workflow.Steps[index - 1]) = (workflow.Steps[index - 1], workflow.Steps[index]);
        ReorderSteps();
    }

    private void MoveStepDown(int index)
    {
        if (workflow is null || index >= workflow.Steps.Count - 1) return;
        (workflow.Steps[index], workflow.Steps[index + 1]) = (workflow.Steps[index + 1], workflow.Steps[index]);
        ReorderSteps();
    }

    private void ReorderSteps()
    {
        if (workflow is null) return;
        for (int i = 0; i < workflow.Steps.Count; i++)
        {
            workflow.Steps[i].Order = i + 1;
        }
    }

    // ─── Preview ────────────────────────────────────────────────────────────────

    private async Task RunPreview()
    {
        if (workflow is null || string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery)) return;

        previewExecuting = true;
        StateHasChanged();

        previewResult = await QueryService.ExecuteWidgetQueryAsync(workflow.TriggerKqlQuery, [], TimeSpan.FromHours(24));

        previewExecuting = false;
        StateHasChanged();
    }

    // ─── AI Assistant Overlay ───────────────────────────────────────────────────

    private void OpenTriggerAiAssistant()
    {
        aiPanelPlaceholder = "Describe the workflow trigger you want to match...";
        aiPanelExistingQuery = workflow?.TriggerKqlQuery;
        aiPanelExtraContext = null;
        aiPanelContextKey = "trigger";
        aiPanelStepIndex = null;
        showAiPanel = true;
    }

    private void OpenStepAiAssistant(int index)
    {
        if (workflow is null || index >= workflow.Steps.Count) return;
        aiPanelPlaceholder = "Describe what this step should detect...";
        aiPanelExistingQuery = workflow.Steps[index].KqlQuery;
        aiPanelExtraContext = "Note: This query is for a workflow step. Use `_filter_operationid` to reference the OperationId from the trigger result.";
        aiPanelContextKey = $"step-{index}";
        aiPanelStepIndex = index;
        showAiPanel = true;
    }

    private void CloseAiPanel()
    {
        showAiPanel = false;
    }

    private void ApplyAiKql(string kql)
    {
        if (workflow is null || string.IsNullOrEmpty(kql)) return;

        if (aiPanelStepIndex is not null && aiPanelStepIndex.Value < workflow.Steps.Count)
        {
            workflow.Steps[aiPanelStepIndex.Value].KqlQuery = kql;
        }
        else
        {
            workflow.TriggerKqlQuery = kql;
        }
    }

    // ─── Save / Cancel ──────────────────────────────────────────────────────────

    private async Task Save()
    {
        if (workflow is null) return;
        await WorkflowService.UpdateWorkflowAsync(workflow);
        NotificationService.Notify(new Radzen.NotificationMessage
        {
            Summary = "Workflow saved",
            Severity = Radzen.NotificationSeverity.Success,
            Duration = 3000
        });
        Navigation.NavigateTo($"/workflows/{Id}");
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/workflows/{Id}");
    }
}
