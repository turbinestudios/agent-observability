@page "/workflows/{Id}/edit"
@layout AgentObservability.Dashboard.Components.Layout.WorkflowLayout
@inject AgentObservability.Dashboard.Services.WorkflowManagementService WorkflowService
@inject AgentObservability.Dashboard.Services.WidgetQueryService QueryService
@inject AgentObservability.Dashboard.Services.KqlGenerationService KqlGenerationService
@inject AgentObservability.Dashboard.Services.LearningService LearningService
@inject NavigationManager Navigation
@inject Radzen.NotificationService NotificationService
@using AgentObservability.Dashboard.Models
@using Markdig

<PageTitle>Edit - @(workflow?.Name ?? "Workflow")</PageTitle>

@if (workflow is null)
{
    <p class="loading-state">Loading workflow...</p>
}
else
{
    <div class="dashboard-toolbar">
        <div>
            <p class="eyebrow">Editing Workflow</p>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <input class="form-group input" style="font-size: 1.5rem; font-weight: 700; border: none; background: transparent; padding: 0; width: auto;"
                       @bind="workflow.Name" @bind:event="oninput" />
            </div>
        </div>
        <div class="dashboard-toolbar-actions">
            <button class="action-button action-button-secondary" @onclick="Cancel">Cancel</button>
            <button class="action-button" @onclick="Save">Save</button>
        </div>
    </div>

    <!-- Trigger KQL Query -->
    <div class="widget-config-panel" style="margin-bottom: 1.5rem;">
        <h3>Trigger KQL Query</h3>
        <p style="color: var(--muted); font-size: 0.85rem; margin-bottom: 0.75rem;">
            Define a KQL query that identifies workflow instances. The query should return an <code>OperationId</code> column to correlate with step logs.
        </p>
        <div class="form-group full-width">
            <textarea rows="8" class="query-textarea"
                      @bind="workflow.TriggerKqlQuery" @bind:event="oninput"
                      placeholder="Enter your trigger KQL query..."></textarea>
            <div class="query-preview-actions" style="margin-top: 0.5rem;">
                <button class="action-button action-button-secondary" @onclick="RunPreview" disabled="@(previewExecuting || string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery))">
                    @if (previewExecuting)
                    {
                        <span class="spinner"></span>
                        <span>Running...</span>
                    }
                    else
                    {
                        <span>▶ Run Preview</span>
                    }
                </button>
            </div>
        </div>

        @if (previewResult?.Error is not null)
        {
            <div class="widget-error" style="margin-top: 0.75rem;">
                <strong>Query Error:</strong> @previewResult.Error
            </div>
        }
        else if (previewResult is not null)
        {
            <div style="margin-top: 0.75rem;">
                <span class="tree-badge">@previewResult.Rows.Count result(s)</span>
                @if (previewResult.Rows.Count > 0)
                {
                    <div class="widget-table-container" style="max-height: 200px; overflow-y: auto; margin-top: 0.5rem;">
                        <table class="widget-table">
                            <thead>
                                <tr>
                                    @foreach (var col in previewResult.Columns)
                                    {
                                        <th>@col</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in previewResult.Rows.Take(10))
                                {
                                    <tr>
                                        @foreach (var col in previewResult.Columns)
                                        {
                                            <td>@(row.TryGetValue(col, out var val) ? val?.ToString() ?? "" : "")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (previewResult.Rows.Count > 10)
                    {
                        <p style="color: var(--muted); font-size: 0.8rem; margin-top: 0.25rem;">Showing first 10 of @previewResult.Rows.Count results</p>
                    }
                }
            </div>
        }

        <!-- AI Query Assistant -->
        <div class="form-group full-width" style="margin-top: 1rem;">
            <div class="ai-assistant-header">
                <label>AI Query Assistant</label>
                <button class="teach-mode-toggle @(isTeachMode ? "active" : "")" @onclick="ToggleTeachMode">
                    <span class="teach-icon">🎓</span>
                    <span>@(isTeachMode ? "Back to Query" : "Teach AI")</span>
                </button>
            </div>
            <div class="ai-assistant-panel @(isTeachMode ? "teach-mode" : "")">
                @if (isTeachMode)
                {
                    <div class="ai-input-row">
                        <textarea rows="2" class="query-textarea"
                                  @bind="teachPrompt" @bind:event="oninput"
                                  placeholder="Describe what you'd like to teach the AI (e.g., rules, patterns, conventions)..."
                                  disabled="@teachGenerating"
                                  @onkeydown="OnTeachPromptKeyDown"></textarea>
                        <button class="action-button" @onclick="SendTeachMessage" disabled="@(teachGenerating || string.IsNullOrWhiteSpace(teachPrompt))">
                            @if (teachGenerating)
                            {
                                <span class="spinner"></span>
                            }
                            else
                            {
                                <span>Send</span>
                            }
                        </button>
                    </div>

                    @if (teachConversation.Count > 0)
                    {
                        <div class="ai-conversation">
                            @foreach (var message in teachConversation.AsEnumerable().Reverse())
                            {
                                <div class="ai-message ai-message-@message.Role">
                                    <div class="ai-message-header">@(message.Role == "user" ? "You" : "AI")</div>
                                    @if (message.Role == "user")
                                    {
                                        <div class="ai-message-content">@message.Text</div>
                                    }
                                    else
                                    {
                                        <div class="ai-message-content">@((MarkupString)RenderMarkdown(message.Text))</div>
                                        @if (currentProposal is not null && message == teachConversation.Last(m => m.Role == "assistant"))
                                        {
                                            <div class="learning-proposal-card">
                                                <div class="learning-proposal-header">
                                                    <span class="teach-icon">🎓</span>
                                                    @if (!string.IsNullOrEmpty(currentProposal.UpdatesLearningId))
                                                    {
                                                        <span>Update Existing Learning</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Proposed Learning</span>
                                                    }
                                                </div>
                                                <div class="learning-proposal-body">
                                                    <div class="learning-proposal-title">@currentProposal.Title</div>
                                                    @if (!string.IsNullOrEmpty(currentProposal.Description))
                                                    {
                                                        <div class="learning-proposal-description">@currentProposal.Description</div>
                                                    }
                                                    <div class="learning-proposal-rule">@currentProposal.RuleText</div>
                                                    @if (!string.IsNullOrEmpty(currentProposal.KqlExample))
                                                    {
                                                        <pre class="ai-preview-code">@currentProposal.KqlExample</pre>
                                                    }
                                                </div>
                                                <div class="learning-proposal-actions">
                                                    <button class="action-button" @onclick="SaveProposedLearning" disabled="@savingLearning">
                                                        @if (savingLearning)
                                                        {
                                                            <span class="spinner"></span>
                                                        }
                                                        else if (!string.IsNullOrEmpty(currentProposal.UpdatesLearningId))
                                                        {
                                                            <span>Update Learning</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Save Learning</span>
                                                        }
                                                    </button>
                                                    <button class="action-button action-button-secondary" @onclick="DismissProposal">Dismiss</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="ai-input-row">
                        <textarea rows="2" class="query-textarea"
                                  @bind="aiPrompt" @bind:event="oninput"
                                  placeholder="Describe the workflow trigger you want to match..."
                                  disabled="@aiGenerating"
                                  @onkeydown="OnAiPromptKeyDown"></textarea>
                        <button class="action-button" @onclick="GenerateKql" disabled="@(aiGenerating || string.IsNullOrWhiteSpace(aiPrompt))">
                            @if (aiGenerating)
                            {
                                <span class="spinner"></span>
                            }
                            else
                            {
                                <span>Send</span>
                            }
                        </button>
                    </div>

                    @if (aiConversation.Count > 0)
                    {
                        <div class="ai-conversation">
                            @foreach (var message in aiConversation.AsEnumerable().Reverse())
                            {
                                <div class="ai-message ai-message-@message.Role">
                                    <div class="ai-message-header">@(message.Role == "user" ? "You" : "AI")</div>
                                    @if (message.Role == "user")
                                    {
                                        <div class="ai-message-content">@message.Text</div>
                                    }
                                    else
                                    {
                                        <div class="ai-message-content">@((MarkupString)RenderMarkdown(message.Text))</div>
                                        @if (!string.IsNullOrEmpty(message.KqlQuery))
                                        {
                                            <div class="ai-preview">
                                                <pre class="ai-preview-code">@message.KqlQuery</pre>
                                                <button class="action-button action-button-secondary ai-apply-btn" @onclick="() => ApplyKql(message.KqlQuery)">Apply to Query</button>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Expected Steps -->
    <div class="widget-config-panel" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
                <h3 style="margin: 0;">Expected Steps</h3>
                <p style="color: var(--muted); font-size: 0.85rem; margin: 0.25rem 0 0;">
                    Define the expected step sequence. Each step uses a KQL query to detect its occurrence. Use <code>_filter_operationid</code> to reference the OperationId from the trigger result.
                </p>
            </div>
            <button class="action-button" @onclick="AddStep">+ Add Step</button>
        </div>

        @if (workflow.Steps.Count == 0)
        {
            <div class="empty-state" style="padding: 1rem;">
                <p>No steps configured. Add steps to define the expected workflow sequence.</p>
            </div>
        }
        else
        {
            @for (int i = 0; i < workflow.Steps.Count; i++)
            {
                var idx = i;
                var step = workflow.Steps[idx];
                <div class="workflow-step-editor" style="flex-direction: column; align-items: stretch;">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <span class="step-number-badge">@step.Order</span>

                        <div class="form-group" style="flex: 1;">
                            <label>Step Name</label>
                            <input @bind="step.Name" @bind:event="oninput" placeholder="e.g. File Read, Code Generation" />
                        </div>

                        <div class="step-actions">
                            <button class="btn-icon" @onclick="() => MoveStepUp(idx)" disabled="@(idx == 0)" title="Move up">↑</button>
                            <button class="btn-icon" @onclick="() => MoveStepDown(idx)" disabled="@(idx == workflow.Steps.Count - 1)" title="Move down">↓</button>
                            <button class="btn-icon" @onclick="() => RemoveStep(idx)" title="Remove">✕</button>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top: 0.5rem;">
                        <label>KQL Query</label>
                        <textarea rows="4" class="query-textarea"
                                  @bind="step.KqlQuery" @bind:event="oninput"
                                  placeholder="e.g. AppDependencies | where OperationId == _filter_operationid | where Name == &quot;read_file&quot;"></textarea>
                    </div>

                    <!-- Step AI Query Assistant -->
                    <div style="margin-top: 0.5rem;">
                        <button class="action-button action-button-secondary" style="font-size: 0.8rem; padding: 0.3rem 0.6rem;"
                                @onclick="() => ToggleStepAi(idx)">
                            @(activeStepAiIndex == idx ? "Hide AI Assistant" : "AI Assistant")
                        </button>

                        @if (activeStepAiIndex == idx)
                        {
                            <div class="ai-assistant-panel @(isStepTeachMode ? "teach-mode" : "")" style="margin-top: 0.5rem;">
                                <div class="ai-assistant-header" style="margin-bottom: 0.5rem;">
                                    <span></span>
                                    <button class="teach-mode-toggle @(isStepTeachMode ? "active" : "")" @onclick="ToggleStepTeachMode">
                                        <span class="teach-icon">🎓</span>
                                        <span>@(isStepTeachMode ? "Back to Query" : "Teach AI")</span>
                                    </button>
                                </div>
                                @if (isStepTeachMode)
                                {
                                    <div class="ai-input-row">
                                        <textarea rows="2" class="query-textarea"
                                                  @bind="teachPrompt" @bind:event="oninput"
                                                  placeholder="Describe what you'd like to teach the AI..."
                                                  disabled="@teachGenerating"
                                                  @onkeydown="OnTeachPromptKeyDown"></textarea>
                                        <button class="action-button" @onclick="SendTeachMessage" disabled="@(teachGenerating || string.IsNullOrWhiteSpace(teachPrompt))">
                                            @if (teachGenerating)
                                            {
                                                <span class="spinner"></span>
                                            }
                                            else
                                            {
                                                <span>Send</span>
                                            }
                                        </button>
                                    </div>

                                    @if (teachConversation.Count > 0)
                                    {
                                        <div class="ai-conversation">
                                            @foreach (var message in teachConversation.AsEnumerable().Reverse())
                                            {
                                                <div class="ai-message ai-message-@message.Role">
                                                    <div class="ai-message-header">@(message.Role == "user" ? "You" : "AI")</div>
                                                    @if (message.Role == "user")
                                                    {
                                                        <div class="ai-message-content">@message.Text</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="ai-message-content">@((MarkupString)RenderMarkdown(message.Text))</div>
                                                        @if (currentProposal is not null && message == teachConversation.Last(m => m.Role == "assistant"))
                                                        {
                                                            <div class="learning-proposal-card">
                                                                <div class="learning-proposal-header">
                                                                    <span class="teach-icon">🎓</span>
                                                                    @if (!string.IsNullOrEmpty(currentProposal.UpdatesLearningId))
                                                                    {
                                                                        <span>Update Existing Learning</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>Proposed Learning</span>
                                                                    }
                                                                </div>
                                                                <div class="learning-proposal-body">
                                                                    <div class="learning-proposal-title">@currentProposal.Title</div>
                                                                    @if (!string.IsNullOrEmpty(currentProposal.Description))
                                                                    {
                                                                        <div class="learning-proposal-description">@currentProposal.Description</div>
                                                                    }
                                                                    <div class="learning-proposal-rule">@currentProposal.RuleText</div>
                                                                    @if (!string.IsNullOrEmpty(currentProposal.KqlExample))
                                                                    {
                                                                        <pre class="ai-preview-code">@currentProposal.KqlExample</pre>
                                                                    }
                                                                </div>
                                                                <div class="learning-proposal-actions">
                                                                    <button class="action-button" @onclick="SaveProposedLearning" disabled="@savingLearning">
                                                                        @if (savingLearning)
                                                                        {
                                                                            <span class="spinner"></span>
                                                                        }
                                                                        else if (!string.IsNullOrEmpty(currentProposal.UpdatesLearningId))
                                                                        {
                                                                            <span>Update Learning</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>Save Learning</span>
                                                                        }
                                                                    </button>
                                                                    <button class="action-button action-button-secondary" @onclick="DismissProposal">Dismiss</button>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="ai-input-row">
                                        <textarea rows="2" class="query-textarea"
                                                  @bind="stepAiPrompt" @bind:event="oninput"
                                                  placeholder="Describe what this step should detect..."
                                                  disabled="@stepAiGenerating"
                                                  @onkeydown="OnStepAiPromptKeyDown"></textarea>
                                        <button class="action-button" @onclick="GenerateStepKql" disabled="@(stepAiGenerating || string.IsNullOrWhiteSpace(stepAiPrompt))">
                                            @if (stepAiGenerating)
                                            {
                                                <span class="spinner"></span>
                                            }
                                            else
                                            {
                                                <span>Send</span>
                                            }
                                        </button>
                                    </div>

                                    @if (GetStepAiConversation(idx).Count > 0)
                                    {
                                        <div class="ai-conversation">
                                            @foreach (var message in GetStepAiConversation(idx).AsEnumerable().Reverse())
                                            {
                                                <div class="ai-message ai-message-@message.Role">
                                                    <div class="ai-message-header">@(message.Role == "user" ? "You" : "AI")</div>
                                                    @if (message.Role == "user")
                                                    {
                                                        <div class="ai-message-content">@message.Text</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="ai-message-content">@((MarkupString)RenderMarkdown(message.Text))</div>
                                                        @if (!string.IsNullOrEmpty(message.KqlQuery))
                                                        {
                                                            var capturedIdx = idx;
                                                            <div class="ai-preview">
                                                                <pre class="ai-preview-code">@message.KqlQuery</pre>
                                                                <button class="action-button action-button-secondary ai-apply-btn" @onclick="() => ApplyStepKql(capturedIdx, message.KqlQuery)">Apply to Step</button>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ManagedWorkflow? workflow;

    // Preview state
    private WidgetQueryResult? previewResult;
    private bool previewExecuting;

    // AI assistant state (trigger)
    private string aiPrompt = string.Empty;
    private bool aiGenerating;
    private List<AiConversationMessage> aiConversation = [];

    // AI assistant state (steps)
    private int? activeStepAiIndex;
    private string stepAiPrompt = string.Empty;
    private bool stepAiGenerating;
    private Dictionary<int, List<AiConversationMessage>> stepAiConversations = [];

    // Teach mode state (shared across trigger & step AI)
    private bool isTeachMode;
    private bool isStepTeachMode;
    private string teachPrompt = string.Empty;
    private bool teachGenerating;
    private bool savingLearning;
    private List<AiConversationMessage> teachConversation = [];
    private LearningProposal? currentProposal;

    protected override async Task OnInitializedAsync()
    {
        workflow = await WorkflowService.GetWorkflowAsync(Id);
        if (workflow is null)
        {
            Navigation.NavigateTo("/workflows");
        }
    }

    // ─── Steps ──────────────────────────────────────────────────────────────────

    private void AddStep()
    {
        if (workflow is null) return;
        workflow.Steps.Add(new WorkflowStep
        {
            Order = workflow.Steps.Count + 1,
            Name = string.Empty,
            KqlQuery = string.Empty
        });
    }

    private void RemoveStep(int index)
    {
        if (workflow is null) return;
        workflow.Steps.RemoveAt(index);
        ReorderSteps();
    }

    private void MoveStepUp(int index)
    {
        if (workflow is null || index <= 0) return;
        (workflow.Steps[index], workflow.Steps[index - 1]) = (workflow.Steps[index - 1], workflow.Steps[index]);
        ReorderSteps();
    }

    private void MoveStepDown(int index)
    {
        if (workflow is null || index >= workflow.Steps.Count - 1) return;
        (workflow.Steps[index], workflow.Steps[index + 1]) = (workflow.Steps[index + 1], workflow.Steps[index]);
        ReorderSteps();
    }

    private void ReorderSteps()
    {
        if (workflow is null) return;
        for (int i = 0; i < workflow.Steps.Count; i++)
        {
            workflow.Steps[i].Order = i + 1;
        }
    }

    // ─── Preview ────────────────────────────────────────────────────────────────

    private async Task RunPreview()
    {
        if (workflow is null || string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery)) return;

        previewExecuting = true;
        StateHasChanged();

        previewResult = await QueryService.ExecuteWidgetQueryAsync(workflow.TriggerKqlQuery, [], TimeSpan.FromHours(24));

        previewExecuting = false;
        StateHasChanged();
    }

    // ─── AI Assistant ───────────────────────────────────────────────────────────

    private async Task OnAiPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await GenerateKql();
        }
    }

    private async Task GenerateKql()
    {
        if (workflow is null || string.IsNullOrWhiteSpace(aiPrompt)) return;

        var userText = aiPrompt.Trim();
        aiConversation.Add(new AiConversationMessage("user", userText, null));
        aiPrompt = string.Empty;
        aiGenerating = true;
        StateHasChanged();

        try
        {
            var existingKql = string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery) ? null : workflow.TriggerKqlQuery;

            var history = aiConversation
                .Where(m => m != aiConversation.Last())
                .Select(m => (m.Role, m.Role == "assistant"
                    ? (string.IsNullOrEmpty(m.KqlQuery) ? m.Text : $"{m.Text}\n\n```kql\n{m.KqlQuery}\n```")
                    : m.Text))
                .ToList();

            var result = await KqlGenerationService.GenerateKqlAsync(
                userText,
                [],
                WidgetType.Table,
                existingKql,
                history);

            aiConversation.Add(new AiConversationMessage("assistant", result.Explanation, result.KqlQuery));
        }
        catch (Exception ex)
        {
            aiConversation.Add(new AiConversationMessage("assistant", $"Error: {ex.Message}", null));
        }

        aiGenerating = false;
        StateHasChanged();
    }

    private void ApplyKql(string kql)
    {
        if (workflow is null) return;
        workflow.TriggerKqlQuery = kql;
    }

    // ─── Step AI Assistant ──────────────────────────────────────────────────────

    private void ToggleStepAi(int index)
    {
        activeStepAiIndex = activeStepAiIndex == index ? null : index;
    }

    private List<AiConversationMessage> GetStepAiConversation(int index)
    {
        return stepAiConversations.TryGetValue(index, out var convo) ? convo : [];
    }

    private async Task OnStepAiPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await GenerateStepKql();
        }
    }

    private async Task GenerateStepKql()
    {
        if (workflow is null || activeStepAiIndex is null || string.IsNullOrWhiteSpace(stepAiPrompt)) return;

        var idx = activeStepAiIndex.Value;
        if (!stepAiConversations.ContainsKey(idx))
        {
            stepAiConversations[idx] = [];
        }

        var userText = stepAiPrompt.Trim();
        stepAiConversations[idx].Add(new AiConversationMessage("user", userText, null));
        stepAiPrompt = string.Empty;
        stepAiGenerating = true;
        StateHasChanged();

        try
        {
            var step = workflow.Steps[idx];
            var existingKql = string.IsNullOrWhiteSpace(step.KqlQuery) ? null : step.KqlQuery;

            var history = stepAiConversations[idx]
                .Where(m => m != stepAiConversations[idx].Last())
                .Select(m => (m.Role, m.Role == "assistant"
                    ? (string.IsNullOrEmpty(m.KqlQuery) ? m.Text : $"{m.Text}\n\n```kql\n{m.KqlQuery}\n```")
                    : m.Text))
                .ToList();

            var result = await KqlGenerationService.GenerateKqlAsync(
                userText + "\n\nNote: This query is for a workflow step. Use `_filter_operationid` to reference the OperationId from the trigger result.",
                [],
                WidgetType.Table,
                existingKql,
                history);

            stepAiConversations[idx].Add(new AiConversationMessage("assistant", result.Explanation, result.KqlQuery));
        }
        catch (Exception ex)
        {
            stepAiConversations[idx].Add(new AiConversationMessage("assistant", $"Error: {ex.Message}", null));
        }

        stepAiGenerating = false;
        StateHasChanged();
    }

    private void ApplyStepKql(int index, string kql)
    {
        if (workflow is null || index >= workflow.Steps.Count) return;
        workflow.Steps[index].KqlQuery = kql;
    }

    // ─── Teach Mode ─────────────────────────────────────────────────────────────

    private void ToggleTeachMode()
    {
        isTeachMode = !isTeachMode;
    }

    private void ToggleStepTeachMode()
    {
        isStepTeachMode = !isStepTeachMode;
    }

    private async Task OnTeachPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(teachPrompt) && !teachGenerating)
        {
            await SendTeachMessage();
        }
    }

    private async Task SendTeachMessage()
    {
        if (string.IsNullOrWhiteSpace(teachPrompt)) return;

        var userText = teachPrompt.Trim();
        teachConversation.Add(new AiConversationMessage("user", userText, null));
        teachPrompt = string.Empty;
        teachGenerating = true;
        currentProposal = null;
        StateHasChanged();

        try
        {
            var history = teachConversation
                .SkipLast(1)
                .Select(m => (m.Role, m.Text))
                .ToList();

            var result = await KqlGenerationService.GenerateTeachingResponseAsync(userText, history);

            teachConversation.Add(new AiConversationMessage("assistant", result.Response, null));
            currentProposal = result.Proposal;
        }
        catch (Exception ex)
        {
            teachConversation.Add(new AiConversationMessage("assistant", $"Error: {ex.Message}", null));
        }
        finally
        {
            teachGenerating = false;
            StateHasChanged();
        }
    }

    private async Task SaveProposedLearning()
    {
        if (currentProposal is null) return;

        savingLearning = true;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(currentProposal.UpdatesLearningId))
            {
                var existingLearnings = await LearningService.GetAllLearningsAsync();
                var existing = existingLearnings.FirstOrDefault(l => l.Id == currentProposal.UpdatesLearningId);

                if (existing is not null)
                {
                    existing.Title = currentProposal.Title;
                    existing.Description = currentProposal.Description;
                    existing.RuleText = currentProposal.RuleText;
                    existing.KqlExample = currentProposal.KqlExample;
                    await LearningService.UpdateLearningAsync(existing);
                }
                else
                {
                    var learning = new AiLearning
                    {
                        Title = currentProposal.Title,
                        Description = currentProposal.Description,
                        RuleText = currentProposal.RuleText,
                        KqlExample = currentProposal.KqlExample
                    };
                    await LearningService.SaveLearningAsync(learning);
                }

                NotificationService.Notify(new Radzen.NotificationMessage
                {
                    Summary = $"Learning updated: {currentProposal.Title}",
                    Severity = Radzen.NotificationSeverity.Success,
                    Duration = 4000
                });
            }
            else
            {
                var learning = new AiLearning
                {
                    Title = currentProposal.Title,
                    Description = currentProposal.Description,
                    RuleText = currentProposal.RuleText,
                    KqlExample = currentProposal.KqlExample
                };

                await LearningService.SaveLearningAsync(learning);

                NotificationService.Notify(new Radzen.NotificationMessage
                {
                    Summary = $"Learning saved: {learning.Title}",
                    Severity = Radzen.NotificationSeverity.Success,
                    Duration = 4000
                });
            }

            currentProposal = null;
            teachConversation = [];
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new Radzen.NotificationMessage
            {
                Summary = $"Failed to save learning: {ex.Message}",
                Severity = Radzen.NotificationSeverity.Error,
                Duration = 5000
            });
        }
        finally
        {
            savingLearning = false;
            StateHasChanged();
        }
    }

    private void DismissProposal()
    {
        currentProposal = null;
    }

    // ─── Save / Cancel ──────────────────────────────────────────────────────────

    private async Task Save()
    {
        if (workflow is null) return;
        await WorkflowService.UpdateWorkflowAsync(workflow);
        NotificationService.Notify(new Radzen.NotificationMessage
        {
            Summary = "Workflow saved",
            Severity = Radzen.NotificationSeverity.Success,
            Duration = 3000
        });
        Navigation.NavigateTo($"/workflows/{Id}");
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/workflows/{Id}");
    }

    private static string RenderMarkdown(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        return Markdown.ToHtml(markdown, pipeline);
    }

    private sealed record AiConversationMessage(string Role, string Text, string? KqlQuery);
}
