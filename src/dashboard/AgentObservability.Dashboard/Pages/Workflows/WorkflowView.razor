@page "/workflows/{Id}"
@layout AgentObservability.Dashboard.Components.Layout.WorkflowLayout
@inject AgentObservability.Dashboard.Services.WorkflowManagementService WorkflowService
@inject AgentObservability.Dashboard.Services.WidgetQueryService QueryService
@inject Microsoft.Extensions.Options.IOptions<AgentObservability.Dashboard.Services.WebUxOptions> WebUxOptions
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using AgentObservability.Dashboard.Models
@using System.Text.Json

<PageTitle>@(workflow?.Name ?? "Workflow")</PageTitle>

@if (workflow is null)
{
    <p class="loading-state">Loading workflow...</p>
}
else
{
    <div class="dashboard-toolbar">
        <div>
            <p class="eyebrow">Workflow</p>
            <h1>@workflow.Name</h1>
        </div>
        <div class="dashboard-toolbar-actions">
            @if (rawDetailEnabled)
            {
                <select class="time-range-select" @onchange="OnTimeRangeChanged" value="@selectedTimeRange">
                    <option value="1">Last 1 hour</option>
                    <option value="4">Last 4 hours</option>
                    <option value="12">Last 12 hours</option>
                    <option value="24">Last 24 hours</option>
                    <option value="72">Last 3 days</option>
                    <option value="168">Last 7 days</option>
                    <option value="720">Last 30 days</option>
                </select>
            }
            <button class="action-button" @onclick="EditWorkflow">Edit</button>
        </div>
    </div>

    @if (!rawDetailEnabled)
    {
        <!-- Aggregate-only (privacy-first default): per-interaction run stats and deviation detection
             moved to the local VS Code extension. Show the org-level workflow DEFINITION only. -->
        <div class="workflow-moved-notice empty-state" style="text-align: left;">
            <h3 style="margin-top: 0;">Per-interaction run statistics moved to the local extension</h3>
            <p>
                Workflow run statistics and step deviation detection now run <strong>locally</strong> in the
                <strong>Agent Observability (Local)</strong> VS Code extension, against telemetry on the developer's
                own machine. Raw per-interaction agent correlation (Properties, OperationId, TimeGenerated) no longer
                happens in the org dashboard.
            </p>
            <p>
                This page shows the org-level workflow <strong>definition</strong> below. Edit it here to update the
                expected step sequence the local deviation detector matches against.
            </p>
        </div>

        <div class="widget-config-panel" style="margin-bottom: 1.5rem;">
            <h3>Workflow Definition</h3>
            <div class="workflow-definition">
                <div class="log-property">
                    <span class="log-key">Name:</span>
                    <span class="log-value">@workflow.Name</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery))
                {
                    <div class="log-property">
                        <span class="log-key">Trigger:</span>
                        <span class="log-value">Configured</span>
                    </div>
                }
            </div>
        </div>

        <div class="widget-config-panel">
            <h3>Expected Steps <span class="tree-badge">@workflow.Steps.Count</span></h3>
            @if (workflow.Steps.Count == 0)
            {
                <div class="empty-state" style="padding: 0.5rem;">
                    <p>No expected steps configured. Edit this workflow to define the expected step sequence.</p>
                </div>
            }
            else
            {
                <div class="workflow-steps-comparison">
                    @foreach (var step in workflow.Steps.OrderBy(s => s.Order))
                    {
                        <div class="workflow-step-row">
                            <div class="workflow-step-expected">
                                <div class="step-header">
                                    <span class="step-number">Step @step.Order</span>
                                </div>
                                <div class="step-config">
                                    <span class="step-property">@(string.IsNullOrEmpty(step.Name) ? $"Step {step.Order}" : step.Name)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery))
    {
        <div class="empty-state">
            <p>No trigger query configured. Edit this workflow to add a KQL trigger query.</p>
            <button class="action-button" @onclick="EditWorkflow">Configure Trigger</button>
        </div>
    }
    else
    {
        @if (isLoading)
        {
            <p class="loading-state">Executing trigger query...</p>
        }
        else if (queryResult?.Error is not null)
        {
            <div class="widget-error">
                <strong>Query Error:</strong> @queryResult.Error
            </div>
        }
        else if (queryResult is not null && queryResult.Rows.Count > 0)
        {
            <div class="workflow-view-content @(selectedRow is not null ? "with-detail" : "")">
                <!-- Trigger Results Section -->
                <div class="workflow-results-section">
                    <div class="workflow-results-header" @onclick="ToggleResultsCollapsed">
                        <span class="chevron @(resultsCollapsed ? "" : "expanded")">▶</span>
                        <h3>Trigger Results <span class="tree-badge">@queryResult.Rows.Count</span></h3>
                        @if (!statsComputed && !isComputingStats)
                        {
                            <button class="action-button stat-compute-btn" @onclick="ComputeAllStats" @onclick:stopPropagation="true">Compute Stats</button>
                        }
                        @if (isComputingStats)
                        {
                            <span class="stat-computing">Computing… (@statsProgress / @queryResult.Rows.Count)</span>
                        }
                    </div>

                    @if (statsComputed)
                    {
                        <div class="workflow-stats-bar">
                            <span class="stat-badge success">✓ @statsSuccessCount success</span>
                            <span class="stat-badge warning">⚠ @statsWarningCount warning</span>
                            <span class="stat-badge failed">✗ @statsFailedCount failed</span>
                            @if (statsBlockedCount > 0)
                            {
                                <span class="stat-badge blocked">⛔ @statsBlockedCount blocked</span>
                            }
                        </div>
                    }

                    @if (!resultsCollapsed)
                    {
                        <div class="widget-table-container">
                            <table class="widget-table">
                                <thead>
                                    <tr>
                                        @if (statsComputed)
                                        {
                                            <th style="width: 2.5rem;"></th>
                                        }
                                        @foreach (var col in queryResult.Columns)
                                        {
                                            <th>@col</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int rowIdx = 0; rowIdx < queryResult.Rows.Count; rowIdx++)
                                    {
                                        var row = queryResult.Rows[rowIdx];
                                        var isSelected = row == selectedRow;
                                        var rowStatus = rowStatuses.TryGetValue(rowIdx, out var s) ? s : null;
                                        <tr class="@(isSelected ? "selected-row" : "") @(rowStatus is not null ? $"row-{rowStatus}" : "")"
                                            @onclick="() => SelectRow(row)">
                                            @if (statsComputed)
                                            {
                                                <td class="row-status-cell">
                                                    @switch (rowStatus)
                                                    {
                                                        case "success":
                                                            <span class="step-status matched">✓</span>
                                                            break;
                                                        case "warning":
                                                            <span class="step-status out-of-order">⚠</span>
                                                            break;
                                                        case "failed":
                                                            <span class="step-status missing">✗</span>
                                                            break;
                                                        case "blocked":
                                                            <span class="step-status blocked">⛔</span>
                                                            break;
                                                    }
                                                </td>
                                            }
                                            @foreach (var col in queryResult.Columns)
                                            {
                                                <td>@(row.TryGetValue(col, out var val) ? val?.ToString() ?? "" : "")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Side-by-Side Detail Panel -->
                @if (selectedRow is not null)
                {
                    <div class="workflow-detail-panel">
                        <div class="workflow-detail-header">
                            <h3>Step Matching</h3>
                            <button class="btn-icon" @onclick="CloseDetail" title="Close">✕</button>
                        </div>

                        @if (isLoadingSteps)
                        {
                            <p class="loading-state">Loading step matches...</p>
                        }
                        else
                        {
                            <div class="workflow-steps-comparison">
                                @for (int i = 0; i < workflow.Steps.Count; i++)
                                {
                                    var step = workflow.Steps[i];
                                    var match = stepMatches.ElementAtOrDefault(i);

                                    <div class="workflow-step-row">
                                        <!-- Left: Expected Step Config -->
                                        <div class="workflow-step-expected">
                                            <div class="step-header">
                                                <span class="step-number">Step @step.Order</span>
                                                <span class="step-status @(match?.Status ?? "pending")">
                                                    @switch (match?.Status)
                                                    {
                                                        case "matched":
                                                            <span>✓</span>
                                                            break;
                                                        case "missing":
                                                            <span>✗</span>
                                                            break;
                                                        case "out-of-order":
                                                            <span>⚠</span>
                                                            break;
                                                        case "blocked":
                                                            <span title="@match?.Error">⛔</span>
                                                            break;
                                                        default:
                                                            <span>…</span>
                                                            break;
                                                    }
                                                </span>
                                            </div>
                                            <div class="step-config">
                                                <span class="step-property">@(string.IsNullOrEmpty(step.Name) ? $"Step {step.Order}" : step.Name)</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(step.KqlQuery))
                                            {
                                                <div class="step-query-preview" style="font-size: 0.75rem; color: var(--muted); font-family: monospace; margin-top: 0.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    @step.KqlQuery.Split('\n').FirstOrDefault()
                                                </div>
                                            }
                                        </div>

                                        <!-- Right: Actual Matched Log -->
                                        <div class="workflow-step-actual">
                                            @if (match?.MatchedLog is not null)
                                            {
                                                <div class="matched-log">
                                                    @foreach (var kvp in match.MatchedLog)
                                                    {
                                                        <div class="log-property">
                                                            <span class="log-key">@kvp.Key:</span>
                                                            <span class="log-value">@(kvp.Value?.ToString() ?? "null")</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else if (match?.Status == "blocked")
                                            {
                                                <div class="no-match widget-error">
                                                    <span>Step query blocked: @match.Error</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="no-match">
                                                    <span>No matching log found</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (workflow.Steps.Count == 0)
                                {
                                    <div class="empty-state">
                                        <p>No expected steps configured for this workflow.</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No results found for the trigger query in the selected time range.</p>
            </div>
        }
    }
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ManagedWorkflow? workflow;
    private WidgetQueryResult? queryResult;
    private Dictionary<string, object?>? selectedRow;
    private List<StepMatchResult> stepMatches = [];
    private bool isLoading;
    private bool isLoadingSteps;
    private string selectedTimeRange = "24";
    private bool resultsCollapsed;
    private Dictionary<int, string> rowStatuses = new();
    private bool isComputingStats;
    private bool statsComputed;
    private int statsProgress;
    private int statsSuccessCount;
    private int statsWarningCount;
    private int statsFailedCount;
    private int statsBlockedCount;

    /// <summary>
    /// Master switch (WebUxOptions.ExposeRawSessionDetail). When false (privacy-first default) this
    /// page does NOT execute the raw trigger/step KQL; it renders the moved-to-extension notice plus
    /// the org-level workflow definition. When true (one-release rollback) the prior raw-KQL run
    /// behavior is preserved.
    /// </summary>
    private bool rawDetailEnabled;

    protected override async Task OnInitializedAsync()
    {
        rawDetailEnabled = WebUxOptions.Value.ExposeRawSessionDetail;
        workflow = await WorkflowService.GetWorkflowAsync(Id);
        if (rawDetailEnabled && workflow is not null && !string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery))
        {
            await ExecuteTriggerQuery();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Persisted run stats only exist in the raw-execution (rollback) world.
        if (firstRender && rawDetailEnabled)
        {
            await RestoreStatsFromSessionStorage();
        }
    }

    private async Task ExecuteTriggerQuery()
    {
        if (workflow is null || string.IsNullOrWhiteSpace(workflow.TriggerKqlQuery)) return;

        isLoading = true;
        StateHasChanged();

        var lookback = TimeSpan.FromHours(int.Parse(selectedTimeRange));
        queryResult = await QueryService.ExecuteWidgetQueryAsync(workflow.TriggerKqlQuery, [], lookback);

        isLoading = false;
        StateHasChanged();
    }

    private async Task SelectRow(Dictionary<string, object?> row)
    {
        selectedRow = row;
        isLoadingSteps = true;
        StateHasChanged();

        await LoadStepMatches(row);

        isLoadingSteps = false;
        StateHasChanged();
    }

    private async Task LoadStepMatches(Dictionary<string, object?> row)
    {
        stepMatches = [];

        // Extract OperationId from the selected row
        var operationId = row.TryGetValue("OperationId", out var opId) ? opId?.ToString()
                        : row.TryGetValue("operationId", out var opId2) ? opId2?.ToString()
                        : row.TryGetValue("operation_Id", out var opId3) ? opId3?.ToString()
                        : null;

        if (string.IsNullOrEmpty(operationId) || workflow is null)
        {
            // No OperationId available — mark all steps as missing
            stepMatches = workflow?.Steps.Select(s => new StepMatchResult { Status = "missing" }).ToList() ?? [];
            return;
        }

        var lookback = TimeSpan.FromHours(int.Parse(selectedTimeRange));
        var orderedSteps = workflow.Steps.OrderBy(s => s.Order).ToList();
        DateTimeOffset? previousTimestamp = null;

        for (int stepIdx = 0; stepIdx < orderedSteps.Count; stepIdx++)
        {
            var step = orderedSteps[stepIdx];
            var matchResult = new StepMatchResult();

            if (string.IsNullOrWhiteSpace(step.KqlQuery))
            {
                matchResult.Status = "missing";
                stepMatches.Add(matchResult);
                continue;
            }

            // Inject OperationId as a let statement (same pattern as dashboard filters)
            var preamble = $"let _filter_operationid = \"{EscapeKql(operationId)}\";\n";
            var fullQuery = preamble + step.KqlQuery;

            var stepResult = await QueryService.ExecuteWidgetQueryAsync(fullQuery, [], lookback);

            if (stepResult?.Error is not null)
            {
                // The query failed (e.g. blocked by the aggregate-only guardrail, or a malformed
                // query during rollback). This is distinct from a step that simply did not occur:
                // represent it as 'blocked' rather than 'missing'.
                matchResult.Status = "blocked";
                matchResult.Error = stepResult.Error;
            }
            else if (stepResult?.Rows is not null && stepResult.Rows.Count > 0)
            {
                matchResult.MatchedLog = stepResult.Rows[0];

                // Check ordering via TimeGenerated
                DateTimeOffset? currentTimestamp = null;
                if (matchResult.MatchedLog.TryGetValue("TimeGenerated", out var tg) && tg is not null)
                {
                    if (DateTimeOffset.TryParse(tg.ToString(), out var parsed))
                    {
                        currentTimestamp = parsed;
                    }
                }

                if (previousTimestamp.HasValue && currentTimestamp.HasValue && currentTimestamp < previousTimestamp)
                {
                    matchResult.Status = "out-of-order";
                }
                else
                {
                    matchResult.Status = "matched";
                }

                if (currentTimestamp.HasValue)
                {
                    previousTimestamp = currentTimestamp;
                }
            }
            else
            {
                matchResult.Status = "missing";
            }

            stepMatches.Add(matchResult);
        }
    }

    private void CloseDetail()
    {
        selectedRow = null;
        stepMatches = [];
    }

    private void EditWorkflow()
    {
        Navigation.NavigateTo($"/workflows/{Id}/edit");
    }

    private async Task OnTimeRangeChanged(ChangeEventArgs e)
    {
        selectedTimeRange = e.Value?.ToString() ?? "24";
        selectedRow = null;
        stepMatches = [];
        rowStatuses = new();
        statsComputed = false;
        statsProgress = 0;
        await ExecuteTriggerQuery();
    }

    private void ToggleResultsCollapsed()
    {
        resultsCollapsed = !resultsCollapsed;
    }

    private async Task ComputeAllStats()
    {
        if (workflow is null || queryResult is null) return;

        isComputingStats = true;
        statsProgress = 0;
        rowStatuses = new();
        StateHasChanged();

        var lookback = TimeSpan.FromHours(int.Parse(selectedTimeRange));
        var orderedSteps = workflow.Steps.OrderBy(s => s.Order).ToList();

        for (int rowIdx = 0; rowIdx < queryResult.Rows.Count; rowIdx++)
        {
            var row = queryResult.Rows[rowIdx];

            var operationId = row.TryGetValue("OperationId", out var opId) ? opId?.ToString()
                            : row.TryGetValue("operationId", out var opId2) ? opId2?.ToString()
                            : row.TryGetValue("operation_Id", out var opId3) ? opId3?.ToString()
                            : null;

            if (string.IsNullOrEmpty(operationId))
            {
                rowStatuses[rowIdx] = "failed";
                statsProgress = rowIdx + 1;
                StateHasChanged();
                continue;
            }

            var hasOutOfOrder = false;
            var hasMissing = false;
            var hasBlocked = false;
            DateTimeOffset? previousTimestamp = null;

            for (int stepIdx = 0; stepIdx < orderedSteps.Count; stepIdx++)
            {
                var step = orderedSteps[stepIdx];

                if (string.IsNullOrWhiteSpace(step.KqlQuery))
                {
                    hasMissing = true;
                    continue;
                }

                var preamble = $"let _filter_operationid = \"{EscapeKql(operationId)}\";\n";
                var fullQuery = preamble + step.KqlQuery;
                var stepResult = await QueryService.ExecuteWidgetQueryAsync(fullQuery, [], lookback);

                if (stepResult?.Error is not null)
                {
                    // Query errored/was blocked — distinct from a step that did not occur.
                    hasBlocked = true;
                }
                else if (stepResult?.Rows is not null && stepResult.Rows.Count > 0)
                {
                    DateTimeOffset? currentTimestamp = null;
                    if (stepResult.Rows[0].TryGetValue("TimeGenerated", out var tg) && tg is not null)
                    {
                        if (DateTimeOffset.TryParse(tg.ToString(), out var parsed))
                        {
                            currentTimestamp = parsed;
                        }
                    }

                    if (previousTimestamp.HasValue && currentTimestamp.HasValue && currentTimestamp < previousTimestamp)
                    {
                        hasOutOfOrder = true;
                    }

                    if (currentTimestamp.HasValue)
                    {
                        previousTimestamp = currentTimestamp;
                    }
                }
                else
                {
                    hasMissing = true;
                }
            }

            if (hasBlocked)
                rowStatuses[rowIdx] = "blocked";
            else if (hasMissing)
                rowStatuses[rowIdx] = "failed";
            else if (hasOutOfOrder)
                rowStatuses[rowIdx] = "warning";
            else
                rowStatuses[rowIdx] = "success";

            statsProgress = rowIdx + 1;
            StateHasChanged();
        }

        statsSuccessCount = rowStatuses.Values.Count(v => v == "success");
        statsWarningCount = rowStatuses.Values.Count(v => v == "warning");
        statsFailedCount = rowStatuses.Values.Count(v => v == "failed");
        statsBlockedCount = rowStatuses.Values.Count(v => v == "blocked");
        statsComputed = true;
        isComputingStats = false;
        StateHasChanged();

        await PersistStatsToSessionStorage();
    }

    private string StatsSessionKey => $"workflow-stats-{Id}-{selectedTimeRange}";

    private async Task PersistStatsToSessionStorage()
    {
        var data = new WorkflowStatsCache
        {
            RowStatuses = rowStatuses,
            SuccessCount = statsSuccessCount,
            WarningCount = statsWarningCount,
            FailedCount = statsFailedCount,
            BlockedCount = statsBlockedCount
        };
        var json = JsonSerializer.Serialize(data);
        await JS.InvokeVoidAsync("sessionStorage.setItem", StatsSessionKey, json);
    }

    private async Task RestoreStatsFromSessionStorage()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", StatsSessionKey);
            if (json is null) return;

            var data = JsonSerializer.Deserialize<WorkflowStatsCache>(json);
            if (data is null) return;

            rowStatuses = data.RowStatuses;
            statsSuccessCount = data.SuccessCount;
            statsWarningCount = data.WarningCount;
            statsFailedCount = data.FailedCount;
            statsBlockedCount = data.BlockedCount;
            statsComputed = true;
            StateHasChanged();
        }
        catch
        {
            // Session storage unavailable or data corrupted — ignore
        }
    }

    private static string EscapeKql(string value)
    {
        return value.Replace("\\", "\\\\").Replace("\"", "\\\"");
    }

    private sealed class StepMatchResult
    {
        public string Status { get; set; } = "pending";
        public Dictionary<string, object?>? MatchedLog { get; set; }
        public string? Error { get; set; }
    }

    private sealed class WorkflowStatsCache
    {
        public Dictionary<int, string> RowStatuses { get; set; } = new();
        public int SuccessCount { get; set; }
        public int WarningCount { get; set; }
        public int FailedCount { get; set; }
        public int BlockedCount { get; set; }
    }
}
