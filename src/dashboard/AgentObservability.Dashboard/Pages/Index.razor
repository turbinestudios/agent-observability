@page "/"
@implements IAsyncDisposable
@inject LogAnalyticsService Analytics

<PageTitle>Overview</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Overview</p>
        <h1>Operational visibility for agent traffic</h1>
        <p class="page-copy">Monitor overall request flow, latency, repository coverage, and model mix from a single workspace-backed dashboard.</p>
    </div>

    <button class="action-button" @onclick="LoadAsync">Refresh now</button>
</section>

@if (metrics is null)
{
    <p class="loading-state">Loading dashboard metrics...</p>
}
else
{
    <section class="metric-grid">
        <article class="metric-card">
            <p>Total Requests</p>
            <strong>@metrics.TotalRequests.ToString("N0", CultureInfo.InvariantCulture)</strong>
        </article>
        <article class="metric-card">
            <p>Avg Latency</p>
            <strong>@metrics.AverageLatencyMs.ToString("N0", CultureInfo.InvariantCulture) ms</strong>
        </article>
        <article class="metric-card">
            <p>P95 Latency</p>
            <strong>@metrics.P95LatencyMs.ToString("N0", CultureInfo.InvariantCulture) ms</strong>
        </article>
        <article class="metric-card">
            <p>Active Repositories</p>
            <strong>@metrics.ActiveRepositories</strong>
        </article>
        <article class="metric-card">
            <p>Active Developers</p>
            <strong>@metrics.ActiveDevelopers</strong>
        </article>
    </section>

    <section class="chart-grid">
        <article class="panel-card">
            <div class="panel-heading">
                <h2>Request Volume</h2>
                <span>30-minute polling window</span>
            </div>

            @if (metrics.RequestVolume.Count > 0)
            {
                <RadzenChart>
                    <RadzenColumnSeries Data="@metrics.RequestVolume" CategoryProperty="Label" ValueProperty="Value" Title="Requests" />
                    <RadzenCategoryAxis />
                    <RadzenValueAxis />
                </RadzenChart>
            }
            else
            {
                <p class="empty-state">No request volume data available.</p>
            }
        </article>

        <article class="panel-card">
            <div class="panel-heading">
                <h2>Model Mix</h2>
                <span>Request distribution</span>
            </div>

            @if (metrics.ModelBreakdown.Count > 0)
            {
                <RadzenChart>
                    <RadzenDonutSeries Data="@metrics.ModelBreakdown" CategoryProperty="Label" ValueProperty="Value" />
                </RadzenChart>
            }
            else
            {
                <p class="empty-state">No model data available.</p>
            }
        </article>
    </section>
}

@code {
    private DashboardMetrics? metrics;
    private PeriodicTimer? timer;
    private CancellationTokenSource? refreshCts;
    private Task? refreshTask;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        refreshCts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        refreshTask = StartRefreshLoopAsync(refreshCts.Token);
    }

    private async Task LoadAsync()
    {
        metrics = await Analytics.GetDashboardMetricsAsync(TimeSpan.FromHours(24));
    }

    private async Task StartRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (timer is null)
        {
            return;
        }

        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            metrics = await Analytics.GetDashboardMetricsAsync(TimeSpan.FromHours(24), cancellationToken);
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (refreshCts is not null)
        {
            await refreshCts.CancelAsync();
            refreshCts.Dispose();
        }

        timer?.Dispose();

        if (refreshTask is not null)
        {
            try
            {
                await refreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }
}