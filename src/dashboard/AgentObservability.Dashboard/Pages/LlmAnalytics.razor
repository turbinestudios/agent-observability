@page "/llm-analytics"
@inject LogAnalyticsService Analytics

<PageTitle>LLM Analytics</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">LLM Analytics</p>
        <h1>Model usage and token pressure</h1>
        <p class="page-copy">Track request concentration by model and the approximate token volume each model consumes across the selected window.</p>
    </div>
</section>

@if (models.Count == 0)
{
    <p class="loading-state">Loading model analytics...</p>
}
else
{
    <section class="chart-grid chart-grid-wide">
        <article class="panel-card">
            <div class="panel-heading">
                <h2>Requests by Model</h2>
                <span>Last 24 hours</span>
            </div>

            <RadzenChart>
                <RadzenBarSeries Data="@models" CategoryProperty="Label" ValueProperty="Value" Title="Requests" />
                <RadzenCategoryAxis />
                <RadzenValueAxis />
            </RadzenChart>
        </article>

        <article class="panel-card">
            <div class="panel-heading">
                <h2>Approximate Tokens</h2>
                <span>Input + output</span>
            </div>

            <RadzenChart>
                <RadzenColumnSeries Data="@models" CategoryProperty="Label" ValueProperty="SecondaryValue" Title="Tokens" />
                <RadzenCategoryAxis />
                <RadzenValueAxis />
            </RadzenChart>
        </article>
    </section>

    <section class="panel-card">
        <div class="panel-heading">
            <h2>Model Summary</h2>
            <span>Top models by request volume</span>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Requests</th>
                    <th>Approx. Tokens</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in models)
                {
                    <tr>
                        <td>@item.Label</td>
                        <td>@item.Value.ToString("N0", CultureInfo.InvariantCulture)</td>
                        <td>@item.SecondaryValue.ToString("N0", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyList<NamedValue> models = [];

    protected override async Task OnInitializedAsync()
    {
        models = await Analytics.GetModelUsageAsync(TimeSpan.FromHours(24));
    }
}