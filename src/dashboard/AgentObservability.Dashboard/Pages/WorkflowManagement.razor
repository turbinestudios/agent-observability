@page "/workflow-management"
@inject Services.WorkflowManagementService WorkflowService
@using AgentObservability.Dashboard.Models

<PageTitle>Workflow Configuration</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Configuration</p>
        <h1>Repository & Workflow Management</h1>
        <p class="page-copy">Manage repositories and define expected workflows with trigger conditions and step sequences based on gen_ai semantic conventions.</p>
    </div>
</section>

<section class="chart-grid chart-grid-wide">
    <!-- Repository Management -->
    <article class="panel-card">
        <div class="panel-heading">
            <h2>Repositories</h2>
            <button class="action-button" @onclick="ShowAddRepository">+ Add Repository</button>
        </div>

        @if (showRepoForm)
        {
            <div class="form-inline">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="editingRepo.Name" placeholder="e.g. Turbine/agent-observability" />
                </div>
                <div class="form-group">
                    <label>Repository URL</label>
                    <input type="text" @bind="editingRepo.RepoUrl" placeholder="e.g. https://github.com/org/repo" />
                </div>
                <div class="form-actions">
                    <button class="action-button" @onclick="SaveRepository">Save</button>
                    <button class="action-button action-button-secondary" @onclick="CancelRepoEdit">Cancel</button>
                </div>
            </div>
        }

        @if (repositories.Count == 0)
        {
            <p class="empty-state">No repositories configured yet.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Repository URL</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var repo in repositories)
                    {
                        <tr class="@(selectedRepo?.Id == repo.Id ? "row-selected" : "")">
                            <td><a href="javascript:void(0)" @onclick="() => SelectRepository(repo)">@repo.Name</a></td>
                            <td>@repo.RepoUrl</td>
                            <td>
                                <button class="btn-icon" title="Edit" @onclick="() => EditRepository(repo)">✏️</button>
                                <button class="btn-icon" title="Delete" @onclick="() => DeleteRepository(repo)">🗑️</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </article>
</section>

@if (selectedRepo is not null)
{
    <section class="chart-grid chart-grid-wide">
        <!-- Workflow Management -->
        <article class="panel-card">
            <div class="panel-heading">
                <h2>Workflows for @selectedRepo.Name</h2>
                <button class="action-button" @onclick="ShowAddWorkflow">+ Add Workflow</button>
            </div>

            @if (workflows.Count == 0 && !showWorkflowEditor)
            {
                <p class="empty-state">No workflows defined for this repository.</p>
            }

            @if (!showWorkflowEditor)
            {
                @foreach (var wf in workflows)
                {
                    <article class="workflow-card">
                        <div class="workflow-card-header">
                            <h3>@wf.Name</h3>
                            <div>
                                <button class="btn-icon" title="Edit" @onclick="() => EditWorkflow(wf)">✏️</button>
                                <button class="btn-icon" title="Delete" @onclick="() => DeleteWorkflow(wf)">🗑️</button>
                            </div>
                        </div>
                        <p class="workflow-meta">Trigger: <code>@wf.Trigger.AttributeName</code> = <code>@wf.Trigger.ExpectedValue</code></p>
                        <p>@string.Join(" → ", wf.Steps.OrderBy(s => s.Order).Select(s => $"{s.PropertyName}:{s.ExpectedValue}"))</p>
                    </article>
                }
            }

            @if (showWorkflowEditor)
            {
                <div class="workflow-editor">
                    <h3>@(isEditingWorkflow ? "Edit Workflow" : "New Workflow")</h3>

                    <div class="form-group">
                        <label>Workflow Name</label>
                        <input type="text" @bind="editingWorkflow.Name" placeholder="e.g. feature-development" />
                    </div>

                    <fieldset class="form-fieldset">
                        <legend>Trigger Condition</legend>
                        <p class="form-help">This workflow applies when a session contains a span matching this condition.</p>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Attribute</label>
                                <select value="@GetDropdownValue(editingWorkflow.Trigger.AttributeName)" @onchange="e => OnTriggerAttributeChanged(e)">
                                    @foreach (var attr in AttributeOptions)
                                    {
                                        <option value="@attr">@attr</option>
                                    }
                                </select>
                                @if (IsCustomAttribute(editingWorkflow.Trigger.AttributeName))
                                {
                                    <input type="text" class="custom-key-input" @bind="editingWorkflow.Trigger.AttributeName" placeholder="e.g. copilot_chat.session.id" />
                                }
                            </div>
                            <div class="form-group">
                                <label>Expected Value</label>
                                <input type="text" @bind="editingWorkflow.Trigger.ExpectedValue" placeholder="e.g. planner" />
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-fieldset">
                        <legend>Expected Steps</legend>
                        <p class="form-help">Define the ordered sequence of operations expected in this workflow.</p>

                        @for (var i = 0; i < editingWorkflow.Steps.Count; i++)
                        {
                            var step = editingWorkflow.Steps[i];
                            var index = i;
                            <div class="step-row">
                                <span class="step-number">@(index + 1)</span>
                                <select value="@GetDropdownValue(step.PropertyName)" @onchange="e => OnStepAttributeChanged(index, e)">
                                    @foreach (var attr in AttributeOptions)
                                    {
                                        <option value="@attr">@attr</option>
                                    }
                                </select>
                                @if (IsCustomAttribute(step.PropertyName))
                                {
                                    <input type="text" class="custom-key-input" @bind="step.PropertyName" placeholder="Custom property key" />
                                }
                                <input type="text" @bind="step.ExpectedValue" placeholder="Expected value" />
                                <button class="btn-icon" title="Move up" disabled="@(index == 0)" @onclick="() => MoveStepUp(index)">↑</button>
                                <button class="btn-icon" title="Move down" disabled="@(index == editingWorkflow.Steps.Count - 1)" @onclick="() => MoveStepDown(index)">↓</button>
                                <button class="btn-icon" title="Remove step" @onclick="() => RemoveStep(index)">✕</button>
                            </div>
                        }

                        <button class="action-button action-button-secondary" @onclick="AddStep">+ Add Step</button>
                    </fieldset>

                    <div class="form-actions">
                        <button class="action-button" @onclick="SaveWorkflow">Save Workflow</button>
                        <button class="action-button action-button-secondary" @onclick="CancelWorkflowEdit">Cancel</button>
                    </div>
                </div>
            }
        </article>
    </section>
}

@code {
    private List<ManagedRepository> repositories = [];
    private List<ManagedWorkflow> workflows = [];
    private ManagedRepository? selectedRepo;

    // Repository form state
    private bool showRepoForm;
    private bool isEditingRepo;
    private ManagedRepository editingRepo = new();

    // Workflow editor state
    private bool showWorkflowEditor;
    private bool isEditingWorkflow;
    private ManagedWorkflow editingWorkflow = new();

    private static readonly string[] AttributeOptions =
    [
        "tool.name",
        "gen_ai.operation.name",
        "gen_ai.request.model",
        "gen_ai.agent.name",
        "custom"
    ];

    private static readonly HashSet<string> KnownAttributes = new(AttributeOptions.Where(a => a != "custom"));

    private static bool IsCustomAttribute(string value) => !KnownAttributes.Contains(value);

    private static string GetDropdownValue(string value) => KnownAttributes.Contains(value) ? value : "custom";

    private void OnTriggerAttributeChanged(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString() ?? "tool.name";
        editingWorkflow.Trigger.AttributeName = selected == "custom" ? "" : selected;
    }

    private void OnStepAttributeChanged(int index, ChangeEventArgs e)
    {
        var selected = e.Value?.ToString() ?? "tool.name";
        editingWorkflow.Steps[index].PropertyName = selected == "custom" ? "" : selected;
    }

    protected override async Task OnInitializedAsync()
    {
        repositories = await WorkflowService.GetRepositoriesAsync();
    }

    // ─── Repository CRUD ────────────────────────────────────────────────────────

    private void ShowAddRepository()
    {
        editingRepo = new ManagedRepository();
        isEditingRepo = false;
        showRepoForm = true;
    }

    private void EditRepository(ManagedRepository repo)
    {
        editingRepo = new ManagedRepository
        {
            Id = repo.Id,
            Name = repo.Name,
            RepoUrl = repo.RepoUrl
        };
        isEditingRepo = true;
        showRepoForm = true;
    }

    private async Task SaveRepository()
    {
        if (string.IsNullOrWhiteSpace(editingRepo.Name))
        {
            return;
        }

        if (isEditingRepo)
        {
            await WorkflowService.UpdateRepositoryAsync(editingRepo);
        }
        else
        {
            await WorkflowService.AddRepositoryAsync(editingRepo);
        }

        repositories = await WorkflowService.GetRepositoriesAsync();
        showRepoForm = false;
    }

    private async Task DeleteRepository(ManagedRepository repo)
    {
        await WorkflowService.DeleteRepositoryAsync(repo.Id);
        repositories = await WorkflowService.GetRepositoriesAsync();

        if (selectedRepo?.Id == repo.Id)
        {
            selectedRepo = null;
            workflows = [];
        }
    }

    private void CancelRepoEdit()
    {
        showRepoForm = false;
    }

    private async Task SelectRepository(ManagedRepository repo)
    {
        selectedRepo = repo;
        workflows = await WorkflowService.GetWorkflowsAsync(repo.Id);
        showWorkflowEditor = false;
    }

    // ─── Workflow CRUD ──────────────────────────────────────────────────────────

    private void ShowAddWorkflow()
    {
        editingWorkflow = new ManagedWorkflow { RepositoryId = selectedRepo!.Id };
        isEditingWorkflow = false;
        showWorkflowEditor = true;
    }

    private void EditWorkflow(ManagedWorkflow wf)
    {
        editingWorkflow = new ManagedWorkflow
        {
            Id = wf.Id,
            RepositoryId = wf.RepositoryId,
            Name = wf.Name,
            Trigger = new TriggerCondition
            {
                AttributeName = wf.Trigger.AttributeName,
                ExpectedValue = wf.Trigger.ExpectedValue
            },
            Steps = wf.Steps.Select(s => new WorkflowStep
            {
                Order = s.Order,
                PropertyName = s.PropertyName,
                ExpectedValue = s.ExpectedValue
            }).ToList()
        };
        isEditingWorkflow = true;
        showWorkflowEditor = true;
    }

    private async Task SaveWorkflow()
    {
        if (string.IsNullOrWhiteSpace(editingWorkflow.Name))
        {
            return;
        }

        // Recompute step order
        for (var i = 0; i < editingWorkflow.Steps.Count; i++)
        {
            editingWorkflow.Steps[i].Order = i + 1;
        }

        if (isEditingWorkflow)
        {
            await WorkflowService.UpdateWorkflowAsync(editingWorkflow);
        }
        else
        {
            await WorkflowService.AddWorkflowAsync(editingWorkflow);
        }

        workflows = await WorkflowService.GetWorkflowsAsync(selectedRepo!.Id);
        showWorkflowEditor = false;
    }

    private async Task DeleteWorkflow(ManagedWorkflow wf)
    {
        await WorkflowService.DeleteWorkflowAsync(wf.RepositoryId, wf.Id);
        workflows = await WorkflowService.GetWorkflowsAsync(selectedRepo!.Id);
    }

    private void CancelWorkflowEdit()
    {
        showWorkflowEditor = false;
    }

    // ─── Step Management ────────────────────────────────────────────────────────

    private void AddStep()
    {
        editingWorkflow.Steps.Add(new WorkflowStep
        {
            Order = editingWorkflow.Steps.Count + 1
        });
    }

    private void RemoveStep(int index)
    {
        editingWorkflow.Steps.RemoveAt(index);
    }

    private void MoveStepUp(int index)
    {
        if (index <= 0) return;
        (editingWorkflow.Steps[index], editingWorkflow.Steps[index - 1]) =
            (editingWorkflow.Steps[index - 1], editingWorkflow.Steps[index]);
    }

    private void MoveStepDown(int index)
    {
        if (index >= editingWorkflow.Steps.Count - 1) return;
        (editingWorkflow.Steps[index], editingWorkflow.Steps[index + 1]) =
            (editingWorkflow.Steps[index + 1], editingWorkflow.Steps[index]);
    }
}
