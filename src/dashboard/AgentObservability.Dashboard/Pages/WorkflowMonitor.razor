@page "/workflow-monitor"
@inject LogAnalyticsService Analytics
@inject WorkflowDeviationDetector Detector

<PageTitle>Workflow Monitor</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Workflow Monitor</p>
        <h1>Agent workflow deviation detection</h1>
        <p class="page-copy">Monitors agent interaction sequences against expected workflows and alerts on deviations, missing steps, timeouts, and anomalies.</p>
    </div>
</section>

@if (deviations.Count > 0)
{
<section class="chart-grid chart-grid-wide">
    <article class="panel-card panel-card-alert">
        <div class="panel-heading">
            <h2>Active Deviations</h2>
            <span>@deviations.Count deviation(s) detected</span>
        </div>

        <div class="deviation-list">
            @foreach (var deviation in deviations)
            {
                <article class="deviation-card deviation-card-@deviation.Type.ToString().ToLowerInvariant()">
                    <div class="deviation-header">
                        <span class="deviation-type-badge">@deviation.Type</span>
                        <span class="deviation-time">@deviation.DetectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span>
                    </div>
                    <p class="deviation-repo">@deviation.Repository / @deviation.WorkflowName</p>
                    <p class="deviation-description">@deviation.Description</p>
                    @if (deviation.ActualSequence.Count > 0)
                    {
                        <p class="deviation-sequence">Actual: @string.Join(" → ", deviation.ActualSequence)</p>
                    }
                </article>
            }
        </div>
    </article>
</section>
}

<section class="chart-grid chart-grid-wide">
    <article class="panel-card">
        <div class="panel-heading">
            <h2>Expected Workflow Templates</h2>
            <span>Repository-owned definitions</span>
        </div>

        <div class="workflow-list">
            @foreach (var config in WorkflowConfig.Examples)
            {
                foreach (var workflow in config.Workflows)
                {
                    <article class="workflow-card">
                        <p class="workflow-repo">@config.Repository</p>
                        <h3>@workflow.Name</h3>
                        <p>@string.Join(" → ", workflow.ExpectedSequence)</p>
                        <p class="workflow-meta">Max duration: @workflow.MaxDuration.TotalMinutes.ToString("N0", CultureInfo.InvariantCulture) minutes</p>
                    </article>
                }
            }
        </div>
    </article>

    <article class="panel-card">
        <div class="panel-heading">
            <h2>Recent Interactions</h2>
            <span>Last 24 hours</span>
        </div>

        @if (interactions.Count == 0)
        {
            <p class="loading-state">Loading workflow activity...</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Repository</th>
                        <th>Agent</th>
                        <th>Tool</th>
                        <th>Model</th>
                        <th>Duration</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in interactions)
                    {
                        <tr>
                            <td>@item.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@item.Repository</td>
                            <td>@item.Agent</td>
                            <td>@item.ToolName</td>
                            <td>@item.Model</td>
                            <td>@item.DurationMs.ToString("N0", CultureInfo.InvariantCulture) ms</td>
                            <td>
                                <span class="status-pill @(item.Success ? "status-pill-success" : "status-pill-failure")">
                                    @(item.Success ? "Success" : "Failed")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </article>
</section>

@code {
    private IReadOnlyList<AgentInteraction> interactions = [];
    private IReadOnlyList<WorkflowDeviation> deviations = [];

    protected override async Task OnInitializedAsync()
    {
        interactions = await Analytics.GetWorkflowInteractionsAsync(TimeSpan.FromHours(24));
        deviations = Detector.DetectDeviations(interactions, WorkflowConfig.Examples);
    }
}