@using AgentObservability.Dashboard.Models

@if (QueryResult is null)
{
    <span style="color: var(--muted); font-size: 0.85rem;">Loading...</span>
}
else if (QueryResult.Error is not null)
{
    <span style="color: var(--danger); font-size: 0.82rem;">@QueryResult.Error</span>
}
else
{
    @switch (Widget.WidgetType)
    {
        case WidgetType.MetricCard:
            <MetricCardWidget QueryResult="QueryResult" />
            break;
        case WidgetType.LineChart:
            <LineChartWidget QueryResult="QueryResult" />
            break;
        case WidgetType.BarChart:
            <BarChartWidget QueryResult="QueryResult" />
            break;
        case WidgetType.PieChart:
            <PieChartWidget QueryResult="QueryResult" />
            break;
        case WidgetType.Table:
            <TableWidget QueryResult="QueryResult" />
            break;
    }
}

@code {
    [Parameter, EditorRequired]
    public DashboardWidget Widget { get; set; } = default!;

    [Parameter]
    public WidgetQueryResult? QueryResult { get; set; }
}
