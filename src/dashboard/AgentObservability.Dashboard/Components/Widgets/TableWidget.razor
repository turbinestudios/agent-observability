@using AgentObservability.Dashboard.Models

@if (QueryResult.Rows.Count > 0)
{
    <div style="width: 100%; overflow-x: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    @foreach (var col in QueryResult.Columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in QueryResult.Rows.Take(100))
                {
                    <tr>
                        @foreach (var col in QueryResult.Columns)
                        {
                            <td>@(row.GetValueOrDefault(col)?.ToString() ?? "—")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (QueryResult.Rows.Count > 100)
        {
            <p style="color: var(--muted); font-size: 0.82rem; margin-top: 0.5rem;">
                Showing 100 of @QueryResult.Rows.Count rows
            </p>
        }
    </div>
}
else
{
    <span style="color: var(--muted); font-size: 0.85rem;">No data</span>
}

@code {
    [Parameter, EditorRequired]
    public WidgetQueryResult QueryResult { get; set; } = default!;
}
