@inject NavigationManager Navigation
@implements IDisposable

<header class="shell-header">
    <div class="header-brand">
        <img src="logo.svg" alt="Logo" class="header-logo" />
        <span class="header-title">Agent Observability</span>
    </div>

    <nav class="header-nav">
        <a href="/" class="header-nav-link @(IsOverviewActive ? "active" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            <span>Overview</span>
        </a>
        <a href="/dashboards" class="header-nav-link @(IsDashboardsActive ? "active" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            <span>Dashboards</span>
        </a>
        <a href="/workflows" class="header-nav-link @(IsWorkflowsActive ? "active" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span>Workflows</span>
        </a>
        <a href="/ai-learnings" class="header-nav-link @(IsLearningsActive ? "active" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            <span>AI Learnings</span>
        </a>
    </nav>
</header>

@code {
    private bool IsOverviewActive => !Navigation.Uri.Contains("/dashboards", StringComparison.OrdinalIgnoreCase)
                                   && !Navigation.Uri.Contains("/workflows", StringComparison.OrdinalIgnoreCase)
                                   && !Navigation.Uri.Contains("/ai-learnings", StringComparison.OrdinalIgnoreCase);
    private bool IsDashboardsActive => Navigation.Uri.Contains("/dashboards", StringComparison.OrdinalIgnoreCase);
    private bool IsWorkflowsActive => Navigation.Uri.Contains("/workflows", StringComparison.OrdinalIgnoreCase);
    private bool IsLearningsActive => Navigation.Uri.Contains("/ai-learnings", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
