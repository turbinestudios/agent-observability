@inject AgentObservability.Dashboard.Services.WorkflowManagementService WorkflowService
@inject Radzen.ContextMenuService ContextMenuService
@inject NavigationManager Navigation

<div class="dashboard-nav">
    <div class="dashboard-nav-header">
        <h3>Workflows</h3>
        <button class="btn-icon" title="New folder" @onclick="CreateRootFolder">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
        </button>
    </div>

    <div class="dashboard-nav-tree">
        <div class="tree-item @(SelectedFolderId is null ? "selected" : "")"
             @onclick="() => SelectFolder(null)">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            <span>All Workflows</span>
        </div>

        @if (folders is not null)
        {
            @foreach (var folder in folders.Where(f => f.ParentFolderId is null).OrderBy(f => f.SortOrder))
            {
                <WorkflowTreeItem Folder="folder"
                                  AllFolders="folders"
                                  AllWorkflows="workflows ?? []"
                                  SelectedFolderId="SelectedFolderId"
                                  OnSelect="SelectFolder"
                                  OnContextMenu="ShowFolderContextMenu"
                                  OnRename="RenameFolder"
                                  OnWorkflowNavigate="NavigateToWorkflow"
                                  Depth="0" />
            }

            @if (workflows is not null)
            {
                @foreach (var workflow in workflows.Where(w => w.FolderId is null).OrderBy(w => w.Name))
                {
                    var wfId = workflow.Id;
                    <div class="tree-item tree-dashboard-item"
                         @onclick="() => NavigateToWorkflow(wfId)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        <span class="tree-label">@workflow.Name</span>
                    </div>
                }
            }
        }
    </div>

    @if (isCreatingFolder)
    {
        <div class="folder-create-form">
            <input @bind="newFolderName" @bind:event="oninput" placeholder="Folder name" @onkeydown="HandleCreateKeyDown" />
            <div class="folder-create-actions">
                <button class="btn-icon" @onclick="ConfirmCreateFolder" title="Create">✓</button>
                <button class="btn-icon" @onclick="CancelCreateFolder" title="Cancel">✕</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<string?> OnFolderSelected { get; set; }

    private List<AgentObservability.Dashboard.Models.WorkflowFolder>? folders;
    private List<AgentObservability.Dashboard.Models.ManagedWorkflow>? workflows;
    private string? SelectedFolderId;
    private bool isCreatingFolder;
    private string newFolderName = string.Empty;
    private string? creatingInParentId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        folders = await WorkflowService.GetFoldersAsync();
        workflows = await WorkflowService.GetWorkflowsAsync();
    }

    private void SelectFolder(string? folderId)
    {
        SelectedFolderId = folderId;
        OnFolderSelected.InvokeAsync(folderId);
    }

    private void NavigateToWorkflow(string workflowId)
    {
        Navigation.NavigateTo($"/workflows/{workflowId}");
    }

    private void CreateRootFolder()
    {
        creatingInParentId = null;
        isCreatingFolder = true;
        newFolderName = string.Empty;
    }

    private async Task HandleCreateKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmCreateFolder();
        else if (e.Key == "Escape")
            CancelCreateFolder();
    }

    private async Task ConfirmCreateFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolderName)) return;

        var folder = new AgentObservability.Dashboard.Models.WorkflowFolder
        {
            Name = newFolderName.Trim(),
            ParentFolderId = creatingInParentId,
            SortOrder = folders?.Count(f => f.ParentFolderId == creatingInParentId) ?? 0
        };

        await WorkflowService.CreateFolderAsync(folder);
        isCreatingFolder = false;
        newFolderName = string.Empty;
        await LoadDataAsync();
    }

    private void CancelCreateFolder()
    {
        isCreatingFolder = false;
        newFolderName = string.Empty;
    }

    private void ShowFolderContextMenu(Tuple<MouseEventArgs, AgentObservability.Dashboard.Models.WorkflowFolder> args)
    {
        var (mouseArgs, folder) = args;
        ContextMenuService.Open(mouseArgs, new List<Radzen.ContextMenuItem>
        {
            new() { Text = "New Subfolder", Value = "subfolder" },
            new() { Text = "Rename", Value = "rename" },
            new() { Text = "Delete", Value = "delete" }
        }, async (menuArgs) =>
        {
            switch (menuArgs.Value?.ToString())
            {
                case "subfolder":
                    creatingInParentId = folder.Id;
                    isCreatingFolder = true;
                    newFolderName = string.Empty;
                    StateHasChanged();
                    break;
                case "rename":
                    break;
                case "delete":
                    await WorkflowService.DeleteFolderAsync(folder.Id);
                    await LoadDataAsync();
                    if (SelectedFolderId == folder.Id)
                        SelectFolder(null);
                    StateHasChanged();
                    break;
            }
            ContextMenuService.Close();
        });
    }

    private async Task RenameFolder(Tuple<string, string> args)
    {
        var (folderId, newName) = args;
        await WorkflowService.RenameFolderAsync(folderId, newName);
        await LoadDataAsync();
    }
}
