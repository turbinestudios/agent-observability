# Source and tooling — only dist/ + the node-sqlite3-wasm runtime dep ship.
.vscode/**
.vscode-test/**
src/**
out/**
coverage/**

# Build/dev-only scripts (packaging staging, OTLP capture helpers). They run
# from the repo, never from an installed extension.
scripts/**

# Exclude node_modules wholesale. The one runtime dependency, node-sqlite3-wasm,
# is marked external in esbuild (it loads its .wasm sidecar via __dirname, so it
# is NOT bundled into dist/extension.js) and is staged into dist/node_modules by
# scripts/stageSqliteWasm.js — npm workspaces hoist it to the repo root, so it
# cannot be re-included from here. This pattern is anchored and does not match
# dist/node_modules, which ships with the rest of dist/. Being WebAssembly, it
# has no native binary and no Node/Electron ABI to mismatch — one .vsix works
# across all VS Code versions.
node_modules/**

**/*.map
**/*.ts
**/tsconfig.json
**/vitest.config.ts
**/esbuild.js
**/.eslintrc.json
**/eslint.config.js
**/.gitignore
**/.editorconfig

# Keep README, CHANGELOG, LICENSE, package.json, media/ and dist/ in the package.
# The AI Helper's baked-in grounding files (context/*.md) are NOT matched by any
# rule above (they live outside src/ and are not .ts), so they ship by default.
# Made explicit here so the assistant's context is always present in the .vsix.
!context/**

DEVELOPMENT.md
