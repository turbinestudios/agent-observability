{
  "name": "agent-observability-desktop",
  "productName": "Agent Observability",
  "version": "2.4.5",
  "private": true,
  "description": "Standalone desktop app for Agent Observability: a sessions-first view of Copilot and Claude Code agent activity, reading the same on-disk data as the VS Code extension.",
  "license": "MIT",
  "author": "Turbine Studios",
  "repository": {
    "type": "git",
    "url": "https://github.com/turbinestudios/agent-observability.git",
    "directory": "src/desktop/agent-observability-desktop"
  },
  "homepage": "https://github.com/turbinestudios/agent-observability#readme",
  "bugs": {
    "url": "https://github.com/turbinestudios/agent-observability/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run --passWithNoTests",
    "package": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.26",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "jsonc-parser": "^3.3.1",
    "node-sqlite3-wasm": "^0.8.61"
  },
  "devDependencies": {
    "@agent-observability/core": "*",
    "@tanstack/react-virtual": "^3.14.23",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.5.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
